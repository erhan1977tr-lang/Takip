# HTTPS sertifikası Let's Encrypt'ten otomatik alınır ve yenilenir.
{$APP_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 260MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	# İstemci IP'sinin TEK güvenilir kaynağı Caddy'dir (güvenlik denetimi SEC-01): Caddy, istemcinin gönderdiği
	# X-Forwarded-For'u yok sayar ve gerçek bağlantı adresini yazar (trusted_proxies tanımlı değil). İstemcinin
	# gönderebileceği diğer "gerçek IP" başlıkları uygulamaya hiç ulaşmaz. Cloudflare eklenecekse: server/security/client-ip.js
	reverse_proxy app:3000 {
		header_up -CF-Connecting-IP
		header_up -CF-IPCountry
		header_up -True-Client-IP
		header_up -X-Real-IP
	}
}
