# Bu dosyayı .env adıyla kopyalayıp kendi değerlerinizi girin.
# .env git'e YÜKLENMEZ (.gitignore). Şifreleri asla bu örnek dosyaya ya da koda yazmayın.

# --- Uygulama ---
# Tarayıcıda açılan adres (e-postadaki "Giriş ekranına git" düğmesi de bunu kullanır)
APP_URL=https://takip.alanadiniz.ro
# Sunucuda Caddy'nin sertifika alacağı alan adı (APP_URL ile aynı, https:// olmadan)
APP_DOMAIN=takip.alanadiniz.ro
# Oturum ve davet kodu imzaları için gizli anahtar, en az 32 karakter. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Veritabanı ---
# Sunucuda (docker compose) yalnızca şifre yeterli; DATABASE_URL otomatik kurulur.
POSTGRES_PASSWORD=
# Kendi bilgisayarınızda çalıştırırken:
# DATABASE_URL=postgresql://takip:sifre@localhost:5432/takip?schema=public

# --- SMTP ---
# Sunucu adresi. Örnekler:
#   Google Workspace / Gmail : smtp.gmail.com         (587)  — "uygulama şifresi" gerekir
#   Microsoft 365 / Outlook  : smtp.office365.com     (587)  — hesapta "SMTP AUTH" açık olmalı
#   Hosting firması (cPanel) : mail.alanadiniz.ro     (465 veya 587)
SMTP_HOST=mail.alanadiniz.ro
# 587 = STARTTLS (önerilen), 465 = doğrudan TLS
SMTP_PORT=587
# Boş bırakılırsa port 465 ise true, değilse false kabul edilir
SMTP_SECURE=
SMTP_USER=noreply@alanadiniz.ro
SMTP_PASS=
# Gönderen görünen ad ve adres. Adres genelde SMTP_USER ile aynı olmalı, yoksa sunucu reddedebilir.
MAIL_FROM="Takip <noreply@alanadiniz.ro>"
# Sipariş olaylarında bildirim e-postaları (müşteri: teklif, proforma, fatura, yükleme tarihi, çizim onayı;
# iç ekip: yeni sipariş, çizim işleri, müşteri onayları). false = kapalı. Varsayılan: açık.
NOTIFY_EMAILS=true

# --- Davet kodu ---
INVITE_CODE_TTL_HOURS=24

# --- Diğer (boş bırakılırsa varsayılan kullanılır) ---
# Tarihlerin gösterildiği saat dilimi
APP_TIMEZONE=Europe/Bucharest
# Yüklenen dosyaların klasörü. Docker imajında /data/uploads (herkese açık bir klasör OLMAMALI).
# UPLOAD_DIR=./uploads
# Antivirüs (ClamAV clamd). Tanımlıysa yüklenen her dosya taranır; ayarlar yönetici → Entegrasyonlar sayfasından.
# Sunucuda docker compose bunu kendisi verir (clamav:3310).
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# Çerezler yalnızca HTTPS ile gönderilsin mi (boş: üretimde evet)
# COOKIE_SECURE=

# --- Yalnızca geliştirme / test ---
# Ayarlanırsa e-posta gönderilmez, bu klasöre JSON dosyası olarak yazılır. Sunucuda AYARLAMAYIN.
# MAIL_OUTBOX_DIR=./.outbox
# Yerelde http:// ile denerken çerezlerin çalışması için:
# COOKIE_SECURE=false
# Demo ortamı (örnek veriler, demo posta kutusu). Sunucuda AYARLAMAYIN.
# DEMO_MODE=0
# Veritabanı testleri (npm run test:db) için AYRI bir veritabanı — testler tabloları temizler:
# TEST_DATABASE_URL=postgresql://takip:sifre@localhost:5432/takip_test?schema=public
# Uçtan uca testler:
# E2E_BASE_URL=http://localhost:3000
# SCREENSHOT_DIR=./.screens

# --- Yalnızca docker compose ---
# APP_IMAGE=ghcr.io/erhan1977tr-lang/takip
# APP_TAG=latest
