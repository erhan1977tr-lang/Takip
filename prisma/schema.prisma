// =========================================================
// TAKİP - Sipariş ve Üretim Portalı — Veri Modeli (Prisma / PostgreSQL)
// =========================================================
// Akış özeti:
//  1) Müşteri sipariş gönderir -> Order.status = YENI
//  2) Satış dosyayı kontrol eder: çizim gerekiyorsa çizim ekibine yönlendirir (drawingTrack = GEREKLI),
//     gerekmiyorsa drawingTrack = YOK. Her iki durumda status = HAZIRLANIYOR ve teklif taslağı açılır.
//  3) İki hat bağımsız yürür:
//     - Çizim: çizimci üstlenir -> çizimi yükler -> müşteri onaylar ya da revizyon ister
//     - Teklif: satış yazar -> sistem yöneticisi fiyatı onaylar -> teklif müşteride görünür
//     Müşteri teklifi ONAYLAMAZ, yalnızca görür. Müşterinin tek onayı çizim onayıdır.
//  4) Çizim onaylı (ya da gereksiz) ve teklif müşterideyse satış siparişi üretime alır (URETIMDE)
//  5) Yükleme -> arşiv. Her olay OrderEvent'e, her değişiklik AuditLog'a yazılır.
// =========================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// KİMLİK / YETKİ
// ---------------------------------------------------------

enum UserType {
  INTERNAL // Sistem Yöneticisi, Satış, Çizim Ekibi
  CUSTOMER // Müşteri panelini kullanan kişiler
}

// Uygulamadaki panel/rol. Ayrıntılı yetkiler ileride Role/RolePermission ile genişletilir.
enum AppRole {
  ADMIN   // Sistem Yöneticisi
  SATIS
  CIZIM
  MUSTERI
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique // "Sistem Yöneticisi", "Satış", "Çizim Ekibi", "Organizatör"...
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime     @default(now())
}

enum PermissionKey {
  ORDER_VIEW
  ORDER_EDIT
  ORDER_APPROVE
  OFFER_CREATE
  PRICE_SET
  DRAWING_UPLOAD
  DRAWING_APPROVE
  SHIPMENT_MANAGE
  USER_MANAGE
  CUSTOMER_MANAGE
  SETTINGS_MANAGE
  AUDIT_VIEW
}

model RolePermission {
  id     String        @id @default(cuid())
  roleId String
  role   Role          @relation(fields: [roleId], references: [id])
  key    PermissionKey

  @@unique([roleId, key])
}

model User {
  id           String     @id @default(cuid())
  type         UserType
  name         String
  email        String     @unique
  // Yönetici hesabı yalnızca e-postayla açar; kullanıcı ilk girişte davet koduyla şifresini belirleyene kadar boştur.
  passwordHash String?
  phone        String?
  language     String     @default("tr")
  appRole      AppRole
  unit         String?    // birim etiketi: "fabrika satış", "fabrika çizim"...
  canApprove   Boolean    @default(false) // müşteri tarafında çizim onaylayabilir
  roleId       String?
  role         Role?      @relation(fields: [roleId], references: [id])
  teamTags     TeamTagOnUser[]

  // Bağlı olduğu firma: müşteri kullanıcıları için müşteri firması, iç ekip için fabrika
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id])

  // İlişkiler (bu kullanıcının oluşturduğu/atandığı kayıtlar)
  ordersCreated      Order[]        @relation("OrderCreatedBy")
  ordersAssignedDraw Order[]        @relation("OrderAssignedDrawer")
  offersCreated      Offer[]        @relation("OfferCreatedBy")
  pricesSet          Price[]        @relation("PriceSetBy")
  drawingsUploaded   Drawing[]      @relation("DrawingUploadedBy")
  notifications      Notification[]
  auditLogs          AuditLog[]
  invites            UserInvite[]
  sessions           Session[]
  orderNotes         OrderNote[]
  orderFiles         OrderFile[]
  orderEvents        OrderEvent[] @relation("OrderEventBy")

  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// İlk giriş / şifre sıfırlama için e-postayla gönderilen 6 haneli kod.
// Kodun kendisi saklanmaz; yalnızca HMAC özeti (server/auth/inviteCode.js).
// Yeni kod üretildiğinde kullanıcının açık davetleri usedAt ile kapatılır.
model UserInvite {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0) // MAX_ATTEMPTS'e ulaşınca kilitlenir
  usedAt    DateTime?
  sentAt    DateTime? // davet e-postası gönderildiyse; null ise "Davet edilmedi"
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

// Oturum: tarayıcıdaki çerezde rastgele bir belirteç durur, burada yalnızca özeti saklanır.
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?

  @@index([userId])
}

model TeamTag {
  id    String @id @default(cuid())
  name  String @unique // "Ekip etiketleri" menüsündeki gruplamalar
  users TeamTagOnUser[]
}

model TeamTagOnUser {
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  teamTagId String
  teamTag   TeamTag @relation(fields: [teamTagId], references: [id])

  @@id([userId, teamTagId])
}

// ---------------------------------------------------------
// MÜŞTERİ
// ---------------------------------------------------------

enum CustomerType {
  CUSTOMER // müşteri firması
  FACTORY  // fabrika (iç ekip bu firmaya bağlıdır)
}

// Firma: hem müşteri firmaları hem fabrika(lar) burada tutulur.
model Customer {
  id            String   @id @default(cuid())
  name          String   @unique // "Miru Glass", "FOL Expert", "Pelet Construct"...
  type          CustomerType @default(CUSTOMER)
  prefix        String?  @unique // sipariş no ön eki: "MIR" → MIR5; müşteri firmalarında zorunlu
  groupName     String?
  camEtiket     String?  // varsayılan cam etiketi
  sandikEtiket  String?  // varsayılan sandık etiketi (fiziksel etiket ve nakliye listesi)
  contactPerson String?  // "Darius", "Mitariu", "Gabi panou dus" gibi
  email         String?
  phone         String?
  address       String?
  taxId         String?
  users         User[]   // müşteri panelini kullanan kişiler
  orders        Order[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------
// SİPARİŞ
// ---------------------------------------------------------

// Siparişin genel aşaması. Çizim ve teklif, HAZIRLANIYOR aşamasında birbirinden bağımsız yürür.
enum OrderStatus {
  YENI         // müşteri gönderdi, satış inceliyor ("İnceleniyor")
  HAZIRLANIYOR // satış karar verdi; çizim (gerekiyorsa) ve teklif paralel hazırlanıyor
  URETIMDE     // satış üretime aldı (çizim onaylı ya da gereksiz + teklif müşteride)
  YUKLENDI
  ARSIVLENDI
  IPTAL
}

// Çizim hattı: müşteri yalnızca burada onay verir.
enum DrawingTrack {
  YOK              // çizim gerekmiyor
  GEREKLI          // satış çizim ekibine yönlendirdi, henüz üstlenilmedi
  YAPILIYOR        // çizimci üstlendi
  ONAY_BEKLIYOR    // çizim müşterinin onayında
  REVIZYON_ISTENDI // müşteri revizyon istedi
  ONAYLANDI        // müşteri onayladı
}

model Order {
  id                String      @id @default(cuid())
  orderNo           String      @unique // "MIR5", "PEL10", "FOL4"
  customerId        String
  customer          Customer    @relation(fields: [customerId], references: [id])

  customerOrderNo   Int         // müşterinin kendi numarası; orderNo = firma ön eki + bu sayı
  title             String?     // "Gabi panou dus" gibi kısa açıklama
  status            OrderStatus @default(YENI)
  drawingTrack      DrawingTrack @default(YOK)
  drawingSince      DateTime?   // çizim hattının son değiştiği an (SLA için)
  onHold            Boolean     @default(false) // "Beklemeye al": listelerde ve yüklemede görünmez
  camEtiket         String?     // yönetici girer; boşsa firmanın varsayılanı
  sandikEtiket      String?

  createdById       String
  createdBy         User        @relation("OrderCreatedBy", fields: [createdById], references: [id])

  assignedDrawerId  String?
  assignedDrawer    User?       @relation("OrderAssignedDrawer", fields: [assignedDrawerId], references: [id])

  slaDeadline       DateTime?   // "15.0 sa kaldı" / "38.1 sa gecikme" hesaplanır
  estimatedShipDate DateTime?   // Tahmini Yükleme
  actualShipDate    DateTime?

  revisionCount     Int         @default(0)
  isEscalated       Boolean     @default(false)

  items             OrderItem[]
  offers            Offer[]
  price             Price?
  drawings          Drawing[]
  crates            Crate[]
  shipmentId        String?
  shipment          Shipment?   @relation(fields: [shipmentId], references: [id])
  events            OrderEvent[]
  files             OrderFile[]
  notes             OrderNote[]

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([customerId, customerOrderNo])
  @@index([status])
  @@index([drawingTrack])
  @@index([customerId])
  @@index([estimatedShipDate])
}

// Sipariş olay geçmişi ("Hareketler"). event kodları server/orders/rules.js içindeki EVENTS ile tanımlıdır.
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event     String
  note      String?
  userId    String?
  user      User?    @relation("OrderEventBy", fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

enum OrderFileKind {
  CUSTOMER // müşterinin sipariş dosyası
  INTERNAL // iç ekibin eklediği dosya
}

// Yüklenen dosyalar diskte UPLOAD_DIR altında durur; burada yalnızca bilgisi tutulur.
model OrderFile {
  id           String        @id @default(cuid())
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind         OrderFileKind @default(CUSTOMER)
  name         String        // özgün dosya adı
  storageKey   String        @unique
  size         Int
  mime         String?
  uploadedById String
  uploadedBy   User          @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime      @default(now())

  @@index([orderId])
}

// Siparişteki notlar. internal=true ise müşteri görmez. Gönderilen not düzeltilemez.
model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  text      String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([orderId])
}

// Cam kataloğu: müşteri yeni siparişte buradan seçer.
model GlassProduct {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// Cam kalemleri: metraj, cam adedi, CNC, delik, ağırlık — Yüklemeler özetindeki sütunlarla birebir
model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id])
  glassName   String? // müşterinin katalogdan seçtiği cam
  camAdedi    Int     @default(0)
  cnc         String? // CNC açıklaması, yoksa null ("–")
  delikSayisi Int?    // "DELİK" sütunu
  metraj      Decimal @default(0) @db.Decimal(10, 2) // m²
  netAgirlik  Decimal @default(0) @db.Decimal(10, 2) // kg — GERÇEK kayıt (satış girerse tahmini ezer)
  brutAgirlik Decimal? @db.Decimal(10, 2)
}

// ---------------------------------------------------------
// TEKLİF / FİYAT
// ---------------------------------------------------------

enum OfferStatus {
  HAZIRLANIYOR // satışta
  YONETIMDE    // sistem yöneticisinin onayında
  GONDERILDI   // müşteriye gitti
}

model Offer {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id])
  status      OfferStatus @default(HAZIRLANIYOR)
  statusSince DateTime    @default(now()) // SLA için
  sentAt      DateTime?   // müşteriye gönderildiği an
  currency    String      @default("EUR")
  amount      Decimal     @default(0) @db.Decimal(12, 2) // "Teklif Tutarı" (satırların toplamı)
  lines       OfferLine[]
  createdById String
  createdBy   User        @relation("OfferCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([orderId])
}

// Teklif satırı. Metraj = en × boy × adet (m²); tutar = metraj × birim fiyat (birim m² ise) ya da adet × birim fiyat.
model OfferLine {
  id          String  @id @default(cuid())
  offerId     String
  offer       Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  sortOrder   Int     @default(0)
  description String
  poz         String?
  enMm        Int?
  boyMm       Int?
  adet        Int     @default(1)
  unit        String  @default("m2") // "m2" | "adet"
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
}

model Price {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  amount    Decimal  @db.Decimal(12, 2) // "Satış Tutarı" — sistem yöneticisi girer
  setById   String
  setBy     User     @relation("PriceSetBy", fields: [setById], references: [id])
  setAt     DateTime @default(now())
}

// ---------------------------------------------------------
// ÇİZİM
// ---------------------------------------------------------

enum DrawingSource {
  FABRIKA // "Çizim işleri — fabrika çizecek"
  MUSTERI_DXF_DWG // müşteri hazır çizim gönderdi
}

enum DrawingStatus {
  BEKLIYOR
  YAPILIYOR
  ONAY_BEKLIYOR
  ONAYLANDI
  REVIZYON_ISTENDI
}

model Drawing {
  id           String        @id @default(cuid())
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id])
  source       DrawingSource @default(FABRIKA)
  version      Int           @default(1)
  fileUrl      String        // UPLOAD_DIR altındaki depolama anahtarı
  fileName     String?
  fileSize     Int?
  status       DrawingStatus @default(BEKLIYOR)
  uploadedById String
  uploadedBy   User          @relation("DrawingUploadedBy", fields: [uploadedById], references: [id])
  revisions    DrawingRevision[]
  createdAt    DateTime      @default(now())
}

model DrawingRevision {
  id            String   @id @default(cuid())
  drawingId     String
  drawing       Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  requestedById String
  comment       String
  createdAt     DateTime @default(now())
}

// ---------------------------------------------------------
// SANDIK (paketleme)
// ---------------------------------------------------------

model Crate {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id])
  crateNo     Int
  dimensions  String? // "Sandık ölçüleri"
  netAgirlik  Decimal? @db.Decimal(10, 2)
  brutAgirlik Decimal? @db.Decimal(10, 2)
  daraKg      Decimal  @default(50) @db.Decimal(6, 2) // varsayılan dara
}

// ---------------------------------------------------------
// YÜKLEME / TAKVİM
// ---------------------------------------------------------

enum ShipmentStatus {
  PLANLANDI
  BEKLEMEDE // "Beklemeye alınanlar bu listede görünmez"
  YUKLENDI
  IPTAL
}

model Shipment {
  id        String         @id @default(cuid())
  date      DateTime       // Yükleme günü
  status    ShipmentStatus @default(PLANLANDI)
  orders    Order[]
  createdAt DateTime       @default(now())
}

// ---------------------------------------------------------
// SÜREÇ KURALLARI (Ayarlar / Onay politikaları / SLA)
// ---------------------------------------------------------

model SlaPolicy {
  id          String   @id @default(cuid())
  stageName   String   // "İnceleniyor", "Çizim Yapılıyor" vb.
  maxHours    Int
  escalateTo  String?  // eskalasyon rolü/kullanıcı id
  isActive    Boolean  @default(true)
}

model ApprovalPolicy {
  id           String  @id @default(cuid())
  name         String
  maxRevisions Int     @default(3)
  description  String?
  isActive     Boolean @default(true)
}

// ---------------------------------------------------------
// BİLDİRİM
// ---------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------
// DENETİM KAYDI — sadece okunur, hiçbir kayıt silinemez
// ---------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // "ORDER_STATUS_CHANGE", "PRICE_SET", "USER_LOGIN" vb.
  entityType String   // "Order", "Drawing", "Price"...
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}
