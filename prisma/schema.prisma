// =========================================================
// TAKİP - Sipariş ve Üretim Portalı — Veri Modeli (Prisma / PostgreSQL)
// =========================================================
// Akış özeti:
//  1) Müşteri sipariş gönderir -> Order.status = YENI
//  2) Satış dosyayı kontrol eder: çizim gerekiyorsa çizim ekibine yönlendirir (drawingTrack = GEREKLI),
//     gerekmiyorsa drawingTrack = YOK. Her iki durumda status = HAZIRLANIYOR ve teklif taslağı açılır.
//  3) İki hat bağımsız yürür:
//     - Çizim: çizimci üstlenir -> çizimi yükler -> müşteri onaylar ya da revizyon ister
//     - Teklif: satış yazar -> sistem yöneticisi fiyatı onaylar -> teklif müşteride görünür
//     Müşteri teklifi ONAYLAMAZ, yalnızca görür. Müşterinin tek onayı çizim onayıdır.
//  4) Çizim onaylı (ya da gereksiz) ve teklif müşterideyse satış siparişi üretime alır (URETIMDE)
//  5) Yükleme -> arşiv. Her olay OrderEvent'e, her değişiklik AuditLog'a yazılır.
// =========================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// KİMLİK / YETKİ
// ---------------------------------------------------------

enum UserType {
  INTERNAL // Sistem Yöneticisi, Satış, Çizim Ekibi
  CUSTOMER // Müşteri panelini kullanan kişiler
}

// Uygulamadaki panel/rol. Ayrıntılı yetkiler ileride Role/RolePermission ile genişletilir.
// Yetkiler rol adına değil server/auth/permissions.js matrisine göre verilir.
enum AppRole {
  ADMIN     // Sistem Yöneticisi
  YONETICI_YARDIMCISI // Yönetici Yardımcısı: operasyonel yönetici; kullanıcı / güvenlik / kritik ayar yok (karar 219)
  SATIS
  CIZIM
  MUSTERI
  DENETIMCI // yalnızca görüntüler (karar 8)
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique // "Sistem Yöneticisi", "Satış", "Çizim Ekibi", "Organizatör"...
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime     @default(now())
}

// server/auth/permissions.js → PERMISSIONS ile aynı liste (seed bu tabloyu eşitler)
enum PermissionKey {
  ORDER_VIEW
  ORDER_CREATE
  ORDER_REVIEW
  ORDER_CANCEL
  DRAWING_WORK
  DRAWING_APPROVE
  OFFER_VIEW
  OFFER_DRAFT_VIEW
  OFFER_PREPARE
  OFFER_SEND
  PRICE_FINAL_VIEW
  SHIPMENT_VIEW
  FILE_UPLOAD
  FILE_INTERNAL_VIEW
  NOTE_ADD
  NOTE_INTERNAL_VIEW
  CUSTOMER_NAME_VIEW
  USER_MANAGE
  CUSTOMER_MANAGE
  CATALOG_MANAGE
  PRICE_TABLE_MANAGE
  ALERT_VIEW
  CRATE_EDIT
  OFFER_APPROVE
  STOCK_MANAGE
  STOCK_VIEW
  SETTINGS_MANAGE
  AUDIT_VIEW
  ACCOUNTING_MANAGE
  TRANSPORT_LIST_VIEW
  OFFER_EXPORT
  ACCOUNT_SETTINGS
  LOADING_CONFIRM
  SUPPLIER_MANAGE
  OPS_SETTINGS_MANAGE
  CUSTOMER_DELETE
}

// Giriş logu (karar 223): yalnızca yönetici görür, 365 gün saklanır (işçi siler). Şifre, kod, belirteç, çerez, tarayıcı
// bilgisi ve DENENEN e-posta metni hiç yazılmaz; kimliği kesin olmayan başarısız deneme kullanıcıya bağlanmaz (userId boş).
enum LoginEventKind {
  LOGIN // e-posta + şifre
  CODE  // davet kodu adımı
  SETUP // davetle şifre belirlendi (ilk giriş)
}

model LoginEvent {
  id        String         @id @default(cuid())
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  role      AppRole?       // olay anındaki rol (kullanıcı biliniyorsa)
  kind      LoginEventKind
  success   Boolean
  locked    Boolean        @default(false) // bu başarısız deneme bir giriş sınırını doldurdu (geçici kilit başladı)
  ip        String?
  createdAt DateTime       @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

model RolePermission {
  id     String        @id @default(cuid())
  roleId String
  role   Role          @relation(fields: [roleId], references: [id])
  key    PermissionKey

  @@unique([roleId, key])
}

model User {
  id           String     @id @default(cuid())
  type         UserType
  name         String
  email        String     @unique
  // Yönetici hesabı yalnızca e-postayla açar; kullanıcı ilk girişte davet koduyla şifresini belirleyene kadar boştur.
  passwordHash String?
  phone        String?
  language     String     @default("tr")
  fixedLanguage String?   // müşterinin "sabit dil" ayarı: girişte bu dil açılır (boş = giriş ekranındaki dil)
  emailNotifications Boolean @default(true) // bildirim e-postaları (davet / şifre ve fatura belgeleri hariç)
  notificationSound  Boolean @default(true) // uygulama içi bildirim sesi (yalnızca ses; zil, açılır bildirim ve e-posta etkilenmez)
  appRole      AppRole
  unit         String?    // birim etiketi: "fabrika satış", "fabrika çizim"...
  canApprove   Boolean    @default(false) // müşteri tarafında çizim onaylayabilir
  roleId       String?
  role         Role?      @relation(fields: [roleId], references: [id])
  teamTags     TeamTagOnUser[]

  // Bağlı olduğu firma: müşteri kullanıcıları için müşteri firması, iç ekip için fabrika
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id])

  // İlişkiler (bu kullanıcının oluşturduğu/atandığı kayıtlar)
  ordersCreated      Order[]        @relation("OrderCreatedBy")
  ordersAssignedDraw Order[]        @relation("OrderAssignedDrawer")
  offersCreated      Offer[]        @relation("OfferCreatedBy")
  pricesSet          Price[]        @relation("PriceSetBy")
  drawingsUploaded   Drawing[]      @relation("DrawingUploadedBy")
  drawingsSent       Drawing[]      @relation("DrawingSentBy")
  drawingsDecided    Drawing[]      @relation("DrawingDecidedBy")
  drawingFiles       DrawingFile[]  @relation("DrawingFileUploadedBy")
  notifications      Notification[]
  auditLogs          AuditLog[]
  settingsUpdated    IntegrationSetting[]
  // Satışçının fiyat tablosu (Aşama 3b): tek tablo; boşsa varsayılan tablo kullanılır
  priceTableId       String?
  priceTable         PriceTable?    @relation(fields: [priceTableId], references: [id], onDelete: SetNull)
  alertsCreated      AdminAlert[]   @relation("AlertCreatedBy")
  cratesUpdated      Crate[]        @relation("CrateUpdatedBy")
  alertsResolved     AdminAlert[]   @relation("AlertResolvedBy")
  invites            UserInvite[]
  sessions           Session[]
  orderNotes         OrderNote[]
  orderNoteReads     OrderNoteRead[]
  orderFiles         OrderFile[]
  orderEvents        OrderEvent[] @relation("OrderEventBy")
  orderDrafts        OrderDraft[]
  orderDraftFiles    OrderDraftFile[]
  loadingsConfirmed  LoadingConfirmation[] @relation("LoadingConfirmedBy")
  replansCreated     LoadingReplan[] @relation("ReplanCreatedBy")
  loadingCorrections LoadingCorrection[] @relation("LoadingCorrectedBy")
  billingBatches     BillingBatch[] @relation("BillingBatchCreatedBy")
  manualPayments     ManualPayment[] @relation("ManualPaymentCreatedBy")
  manualPaymentsVoided ManualPayment[] @relation("ManualPaymentVoidedBy")
  ordersRemoved      Order[]        @relation("OrderRemovedBy")
  compensationsCreated Compensation[] @relation("CompensationCreatedBy")
  compensationsDecided Compensation[] @relation("CompensationDecidedBy")
  deliveryReports    DeliveryReport[] @relation("DeliveryReportCreatedBy")
  loginEvents        LoginEvent[]

  isActive     Boolean    @default(true)
  // Silinmiş kullanıcı (karar 221): satır silinmez (denetim kaydı değiştirilemez), kimliği anonimleştirilir ve listeden kalkar
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// Hatalı giriş / kod denemeleri: aynı e-posta + IP'den kısa sürede çok deneme olursa giriş geçici kilitlenir
// (server/auth/throttle.js). Başarılı girişte o e-posta + IP'nin kayıtları silinir; eski kayıtlar bir gün sonra temizlenir.
model AuthFailure {
  id        String   @id @default(cuid())
  kind      String   // LOGIN | CODE
  email     String
  ip        String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// İlk giriş / şifre sıfırlama için e-postayla gönderilen 6 haneli kod.
// Kodun kendisi saklanmaz; yalnızca HMAC özeti (server/auth/inviteCode.js).
// Yeni kod üretildiğinde kullanıcının açık davetleri usedAt ile kapatılır.
model UserInvite {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0) // MAX_ATTEMPTS'e ulaşınca kilitlenir
  usedAt    DateTime?
  sentAt    DateTime? // davet e-postası gönderildiyse; null ise "Davet edilmedi"
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

// Oturum: tarayıcıdaki çerezde rastgele bir belirteç durur, burada yalnızca özeti saklanır.
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?

  @@index([userId])
}

model TeamTag {
  id    String @id @default(cuid())
  name  String @unique // "Ekip etiketleri" menüsündeki gruplamalar
  users TeamTagOnUser[]
}

model TeamTagOnUser {
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  teamTagId String
  teamTag   TeamTag @relation(fields: [teamTagId], references: [id])

  @@id([userId, teamTagId])
}

// ---------------------------------------------------------
// MÜŞTERİ
// ---------------------------------------------------------

enum CustomerType {
  CUSTOMER // müşteri firması
  FACTORY  // fabrika (iç ekip bu firmaya bağlıdır)
}

// Firma: hem müşteri firmaları hem fabrika(lar) burada tutulur.
model Customer {
  id            String   @id @default(cuid())
  name          String   @unique // "Miru Glass", "FOL Expert", "Pelet Construct"...
  type          CustomerType @default(CUSTOMER)
  prefix        String?  @unique // firma kodu, tam 3 büyük harf (veritabanında CHECK): "MIR" → MIR5; müşteri firmalarında zorunlu, siparişi olan firmada değişmez
  groupName     String?
  camEtiket     String?  // varsayılan cam etiketi
  sandikEtiket  String?  // varsayılan sandık etiketi (fiziksel etiket ve nakliye listesi)
  contactPerson String?  // "Darius", "Mitariu", "Gabi panou dus" gibi
  email         String?
  // Mali belge e-postası (karar 115): proforma / avans faturası / fatura e-postaları önce bu adrese gider; boşsa `email`.
  // Yalnızca teslim bilgisidir — kimlik doğrulama ya da belgeye erişim hakkı vermez.
  billingEmail  String?
  phone         String?
  address       String?
  taxId         String?  // CUI (fatura: FGO Client[CodUnic])
  // Fatura bilgileri (Aşama 6b, FGO): Nr. Reg. Com., ülke (boşsa RO), județ, localitate
  regCom        String?
  country       String?
  county        String?
  city          String?
  // Kur politikası (Aşama 7D-1, karar 95, 98): cam ve profil FGO belgelerinin kuru. Zorunlu; varsayılan BT.
  // Kur yalnızca server/fx/resolve.js → resolveExchangeRate ile çözülür.
  fxPolicy        FxPolicy @default(BT_UNIT_SELL)
  fxMarkupPercent Decimal? @db.Decimal(6, 3) // yalnızca BNR_PLUS_PERCENT: BNR kuruna eklenen yüzde (2 = %2)
  users         User[]   // müşteri panelini kullanan kişiler
  orders        Order[]
  guestOrders   Order[]  @relation("OrderGuestHost") // bu firmanın yüklemesiyle gidecek başka firma siparişleri (fiziksel)
  orderDrafts   OrderDraft[]
  crates        Crate[]
  loadedItems   LoadingConfirmationItem[]
  replans       LoadingReplan[]
  billingBatches BillingBatch[]
  compensations Compensation[]
  manualPayments ManualPayment[]
  // Müşteriye özel fiyat tablosu (yönetim kopyasında müşteri fiyatları buradan gelir)
  priceTableId  String?
  priceTable    PriceTable? @relation(fields: [priceTableId], references: [id], onDelete: SetNull)
  // Müşteriye özel profil fiyatları (Aşama 6): yoksa katalogdaki liste fiyatı
  profilePriceTableId String?
  profilePriceTable   ProfilePriceTable? @relation(fields: [profilePriceTableId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------
// SİPARİŞ
// ---------------------------------------------------------

// Sipariş tipleri (CLAUDE.md "Order types"). Yeni tip bir satır olarak eklenir; ekranlar ve numara biçimi buradan.
// İlk kayıtlar migration'da ve seed'de (prisma/seed/data/order-types.js).
model OrderType {
  code         String   @id // GLASS_ORDER, PROFILE_ORDER
  nameRo       String
  nameTr       String
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  numberFormat String   @default("{CODE}{SEQ}")
  usesSales    Boolean  @default(true) // false → satış kuyruklarına girmez
  usesDrawing  Boolean  @default(true) // false → çizim kuyruklarına girmez
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Siparişin genel aşaması. Çizim ve teklif, HAZIRLANIYOR aşamasında birbirinden bağımsız yürür.
enum OrderStatus {
  YENI         // müşteri gönderdi, satış inceliyor ("İnceleniyor")
  HAZIRLANIYOR // satış karar verdi; çizim (gerekiyorsa) ve teklif paralel hazırlanıyor
  URETIMDE     // satış üretime aldı (çizim onaylı ya da gereksiz + teklif müşteride)
  YUKLENDI
  ARSIVLENDI
  IPTAL
}

// Çizim hattı: müşteri yalnızca burada onay verir.
enum DrawingTrack {
  YOK              // çizim gerekmiyor
  GEREKLI          // satış çizim ekibine yönlendirdi, henüz üstlenilmedi
  YAPILIYOR        // çizimci üstlendi
  ONAY_BEKLIYOR    // çizim müşterinin onayında
  REVIZYON_ISTENDI // müşteri revizyon istedi
  ONAYLANDI        // müşteri onayladı (ya da çizimci müşterinin DWG/DXF çizimini "üretime hazır" kabul etti — karar 167)
  DUZELTME_BEKLIYOR // çizimci müşterinin DWG/DXF çizimini "hatalı" buldu: müşterinin düzeltilmiş dosyası ya da fabrika çizimi talebi bekleniyor (karar 167)
}

model Order {
  id                String      @id @default(cuid())
  orderNo           String      @unique // firma kodu + müşterinin sipariş numarası: "GLA68" (karar 5)
  customerId        String
  customer          Customer    @relation(fields: [customerId], references: [id])
  orderTypeCode     String      @default("GLASS_ORDER")
  orderType         OrderType   @relation(fields: [orderTypeCode], references: [code])
  // İyimser kilit: her iş akışı işleminde bir artar; aynı anda yapılan iki işlemden ikincisi reddedilir.
  version           Int         @default(0)

  customerOrderNo   Int         // müşterinin sipariş numarası: formda bir sonraki numarayla gelir, müşteri değiştirebilir
  title             String?     // "Gabi panou dus" gibi kısa açıklama
  customerExcel     Boolean     @default(false) // yönetici izni: müşteri teklifi Excel olarak indirebilir (PDF her zaman)
  status            OrderStatus @default(YENI)
  drawingTrack      DrawingTrack @default(YOK)
  drawingSince      DateTime?   // çizim hattının son değiştiği an (SLA için)
  onHold            Boolean     @default(false) // "Beklemeye al": listelerde ve yüklemede görünmez
  camEtiket         String?     // yönetici girer; boşsa firmanın varsayılanı
  sandikEtiket      String?

  createdById       String
  createdBy         User        @relation("OrderCreatedBy", fields: [createdById], references: [id])

  assignedDrawerId  String?
  assignedDrawer    User?       @relation("OrderAssignedDrawer", fields: [assignedDrawerId], references: [id])

  slaDeadline       DateTime?   // "15.0 sa kaldı" / "38.1 sa gecikme" hesaplanır
  estimatedShipDate DateTime?   // Tahmini Yükleme
  actualShipDate    DateTime?

  revisionCount     Int         @default(0)
  isEscalated       Boolean     @default(false)

  items             OrderItem[]
  offers            Offer[]
  price             Price?
  drawings          Drawing[]
  crates            Crate[]      // eski düzen (sipariş başına sandık); taşıma adımı yeni düzene çevirir
  crateLinks        CrateOrder[] // sipariş hangi sandıklarda (yükleme sekmesinde seçilir; başka müşterinin sandığı da olabilir — yalnızca fiziksel yerleşim)
  // Özel durum (karar 124): sipariş, AYNI yükleme gününde başka bir firmanın yüklemesiyle (onun sandığında) gidecek.
  // Yönetici yalnızca ev sahibi FİRMAYI seçer (sandık henüz girilmemiş olabilir); sandığı sonradan satış seçer
  // (CrateOrder). Yalnızca fiziksel yerleşim: siparişin müşterisi, teklifi, belgeleri ve muhasebesi değişmez.
  guestHostId       String?
  guestHost         Customer?   @relation("OrderGuestHost", fields: [guestHostId], references: [id], onDelete: SetNull)
  replans           LoadingReplan[] // yüklenmeyen camın ileri güne aktarımları (Aşama 7E)
  shipmentId        String?
  shipment          Shipment?   @relation(fields: [shipmentId], references: [id])
  events            OrderEvent[]
  files             OrderFile[]
  alerts            AdminAlert[]
  notes             OrderNote[]
  noteReads         OrderNoteRead[]
  outbox            NotificationOutbox[]
  fgoDocuments      FgoDocument[]
  manualPayments    ManualPayment[]
  billingBatchOrders BillingBatchOrder[]
  glassBilling      GlassBilling?
  profile           ProfileOrder?        // yalnızca profil siparişinde
  profileItems      ProfileOrderItem[]
  deliveryPhotos    DeliveryPhoto[]      // profil teslimatının fotoğrafları (Paket 8)
  deliveryReports   DeliveryReport[]     // teslimat raporları (Paket 8)
  stockMoves        StockMovement[]
  loadedItems       LoadingConfirmationItem[] // onaylı yüklemelerde bu siparişin fiilen yüklenen kalemleri

  // Telafi siparişi (Aşama 9, karar 108): kırılan / kusurlu camın yeniden üretimi için açılan ayrı sipariş. Numarası KÖK
  // siparişin numarasından türer: ABC124-T, sonra ABC124-T2, ABC124-T3 … (compSeq = 1, 2, 3; olağan siparişte 0).
  // customerOrderNo kök siparişinkiyle aynıdır; olağan numara sırası değişmez.
  compOfId          String?
  compOf            Order?      @relation("CompensationOrders", fields: [compOfId], references: [id])
  compOrders        Order[]     @relation("CompensationOrders")
  compSeq           Int         @default(0)
  compensationsFrom Compensation[] @relation("CompensationSource") // bu siparişin camı için açılan telafiler
  compensationsTo   Compensation[] @relation("CompensationDest")   // bu siparişe eklenen / bu siparişi oluşturan telafiler

  // Silinmiş sipariş (Aşama 9, karar 110): kayıt durur (FGO, yükleme onayı, denetim, çizim geçmişi korunur) ama sipariş
  // olağan ekranlardan kalkar. Silinince durum IPTAL olur (iptal edilmiş siparişi dışlayan her işlem onu da dışlar) ve
  // önceki durum removedStatus'ta saklanır; geri yüklenince sipariş o duruma döner.
  removedAt         DateTime?
  removedById       String?
  removedBy         User?       @relation("OrderRemovedBy", fields: [removedById], references: [id])
  removedStatus     OrderStatus?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Numara firma ve sipariş tipi içinde tektir: GLA12 (cam) ile GLAP12 (profil) ayrı sıralardır; telafi siparişleri
  // (compSeq > 0) kök siparişin numarasını paylaşır ve sıra numarasıyla ayrılır (aynı anda iki istek aynı numarayı alamaz)
  @@unique([customerId, orderTypeCode, customerOrderNo, compSeq])
  @@index([removedAt])
  @@index([orderTypeCode])
  @@index([status])
  @@index([drawingTrack])
  @@index([customerId])
  @@index([estimatedShipDate])
  @@index([guestHostId])
}

// Taslak sipariş: müşteri formu yarım bırakıp sonra devam eder. Sipariş değildir — numarası, SLA'sı, geçmişi yoktur,
// satışın hiçbir listesine düşmez; yalnızca firmanın müşteri kullanıcıları görür. "Gönder"de sipariş olur ve silinir.
model OrderDraft {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  orderTypeCode   String   @default("GLASS_ORDER")
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  title           String?
  customerOrderNo Int?     // müşteri kendi numarasını yazdıysa; boşsa gönderirken bir sonraki numara önerilir
  note            String?  // "Ek bilgi": gönderilince müşterinin görebildiği not olur
  items           Json     @default("[]") // [{ glassProductId, qty }]
  files           OrderDraftFile[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId])
}

// Taslağa yüklenen dosya (içerik kontrolü ve antivirüsten geçmiş). Gönderilince siparişin dosyası olur.
model OrderDraftFile {
  id            String         @id @default(cuid())
  draftId       String
  draft         OrderDraft     @relation(fields: [draftId], references: [id], onDelete: Cascade)
  name          String
  storageKey    String         @unique
  size          Int
  mime          String?
  checksum      String?
  scanStatus    FileScanStatus @default(PENDING)
  scanSignature String?
  scannedAt     DateTime?
  uploadedById  String
  uploadedBy    User           @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime       @default(now())

  @@index([draftId])
}

// Sipariş olay geçmişi ("Hareketler"). event kodları server/orders/rules.js içindeki EVENTS ile tanımlıdır.
// Sipariş geçmişi: her iş akışı işlemi bir satır (durum değiştirdiyse önceki → sonraki durumla birlikte).
model OrderEvent {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event      String
  note       String?
  fromStatus OrderStatus?
  toStatus   OrderStatus?
  userId    String?
  user      User?    @relation("OrderEventBy", fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// Antivirüs taraması (ADR 0010). PENDING: taranmadı (tarayıcıya ulaşılamadı ya da eski dosya) → işçi sonra tarar.
// SKIPPED: antivirüs kapalıyken yüklendi. INFECTED: karantinada, indirilemez.
enum FileScanStatus {
  PENDING
  CLEAN
  INFECTED
  SKIPPED
}

enum OrderFileKind {
  CUSTOMER // müşterinin sipariş dosyası
  INTERNAL // iç ekibin eklediği dosya
}

// Yüklenen dosyalar diskte UPLOAD_DIR altında durur; burada yalnızca bilgisi tutulur.
model OrderFile {
  id           String        @id @default(cuid())
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind         OrderFileKind @default(CUSTOMER)
  name         String        // özgün dosya adı
  storageKey   String        @unique
  size         Int
  mime         String?       // içerikten belirlenir (uzantıya güvenilmez)
  checksum     String?       // SHA-256 (hex)
  scanStatus   FileScanStatus @default(PENDING)
  scanSignature String?      // virüs adı (INFECTED)
  scannedAt    DateTime?
  // Boş: sistemin ürettiği dosya (Comanda Depozit PDF'i) ya da depo bağlantısından yüklenen teslim belgesi
  uploadedById String?
  uploadedBy   User?         @relation(fields: [uploadedById], references: [id])
  source       String?       // null: kullanıcı · WAREHOUSE_FORM: depo formu (sistem) · DEPOT_LINK: depodan yüklenen teslim belgesi · DELIVERY_PHOTO: teslimat fotoğrafı (Paket 8)
  createdAt    DateTime      @default(now())
  deliveryPhoto DeliveryPhoto? // teslimat fotoğrafıysa bağı (Paket 8)

  @@index([orderId])
}

// Siparişteki notlar. internal=true ise müşteri görmez. Gönderilen not düzeltilemez.
// Otomatik çeviri (karar 127): müşteriye açık not yazılırken BİR KEZ çevrilir ve sonucu burada saklanır; sayfa açılışı
// çeviri yapmaz. Hedef dil yazanın rolünden gelir (müşteri → tr, iç ekip → ro). Çeviri notun görünürlüğünü aynen taşır;
// iç not çevrilmez. Özgün metin (text) hiçbir zaman değişmez. Çeviri kapalıyken / eski notlarda alanların hepsi boştur.
model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  text      String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())
  translation       String?                // çevrilmiş metin (yalnızca DONE)
  translationLang   String?                // hedef dil: tr | ro
  translationStatus NoteTranslationStatus? // boş: çeviri uygulanmadı
  translationError  String?                // güvenli hata kodu (TIMEOUT, QUOTA, AUTH …); Google'ın metni / anahtar saklanmaz
  translationAt     DateTime?              // son durum değişikliği (çeviri / deneme zamanı)
  // Formun tek kullanımlık anahtarı (Paket 9, karar 199): çift tıklama / yeniden gönderim ikinci notu yazmaz
  requestKey        String?  @unique

  @@index([orderId, createdAt])
}

// Kullanıcının siparişteki mesajları en son ne zamana kadar okuduğu (Paket 9, karar 199): sipariş sayfası açılınca
// ilerler, hiçbir zaman geri gitmez. Okunmamış sayısı = görebildiği, başkasının yazdığı ve bu andan sonraki notlar.
model OrderNoteRead {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lastReadAt DateTime

  @@id([userId, orderId])
  @@index([orderId])
}

// PENDING: çeviri isteği sürüyor · DONE: çevrildi · SAME: çeviri özgün metinle aynı (gösterilmez) · FAILED: çevrilemedi
enum NoteTranslationStatus {
  PENDING
  DONE
  SAME
  FAILED
}

// Cam kataloğu: müşteri yeni siparişte buradan seçer (yönetici → Katalog; Excel ile de yüklenir).
// Aynı cam Türkçe ad + Türkçe renkten tanınır. Kullanıcı camı seçtiği dilde görür. Pasif cam hiçbir listede görünmez.
model GlassProduct {
  id         String   @id @default(cuid())
  nameTr     String
  colorTr    String   @default("")
  nameRo     String
  colorRo    String   @default("")
  nameEn     String?  // Excel'de durur; arayüzde İngilizce yok (karar 9)
  colorEn    String?
  weightKgM2 Decimal? @db.Decimal(6, 2) // kg/m² — yüklemelerde ağırlık hesabı; tekliflerde görünmez
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  orderItems OrderItem[]
  prices     PriceTableItem[]

  @@unique([nameTr, colorTr])
}

// Cam kalemleri: metraj, cam adedi, CNC, delik, ağırlık — Yüklemeler özetindeki sütunlarla birebir
model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id])
  // Müşterinin katalogdan seçtiği cam ve sipariş anındaki kopyası (katalog sonradan değişse de sipariş değişmez)
  glassProductId  String?
  glassProduct    GlassProduct? @relation(fields: [glassProductId], references: [id], onDelete: SetNull)
  glassName       String?  // Türkçe ad — renk
  glassNameRo     String?  // Romence ad — renk
  glassWeightKgM2 Decimal? @db.Decimal(6, 2)
  camAdedi    Int     @default(0)
  cnc         String? // CNC açıklaması, yoksa null ("–")
  delikSayisi Int?    // "DELİK" sütunu
  metraj      Decimal @default(0) @db.Decimal(10, 2) // m²
  netAgirlik  Decimal @default(0) @db.Decimal(10, 2) // kg — GERÇEK kayıt (satış girerse tahmini ezer)
  brutAgirlik Decimal? @db.Decimal(10, 2)
}

// ---------------------------------------------------------
// TEKLİF / FİYAT
// ---------------------------------------------------------

enum OfferStatus {
  HAZIRLANIYOR // satışta
  YONETIMDE    // sistem yöneticisinin onayında
  GONDERILDI   // müşteriye gitti
}

model Offer {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id])
  status      OfferStatus @default(HAZIRLANIYOR)
  statusSince DateTime    @default(now()) // SLA için
  sentAt      DateTime?   // müşteriye gönderildiği an
  currency    String      @default("EUR")
  amount      Decimal     @default(0) @db.Decimal(12, 2) // satış tutarı (satış fiyatlarıyla satırların toplamı)
  // Müşteri tutarı (yöneticinin müşteri fiyatlarıyla toplam, karar 4). Müşteri ve denetimci yalnızca bunu görür; satış hiç görmez.
  offerAmount Decimal?    @db.Decimal(12, 2)
  lines       OfferLine[]
  createdById String
  createdBy   User        @relation("OfferCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([orderId])
  // Satır fiyatlarının geldiği fiyat tablosu (teklif açılırken satışçının tablosu)
  priceTableId String?
  priceTable   PriceTable? @relation(fields: [priceTableId], references: [id], onDelete: SetNull)
  alerts       AdminAlert[]
}

// Teklif satırı. Metraj = en × boy × adet (m²); tutar = metraj × birim fiyat (birim m² ise) ya da adet × birim fiyat.
model OfferLine {
  id          String  @id @default(cuid())
  offerId     String
  offer       Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  sortOrder   Int     @default(0)
  description String
  poz         String?
  enMm        Int?
  boyMm       Int?
  adet        Int     @default(1)
  unit        String  @default("m2") // "m2" | "adet"
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  kind        String  @default("CAM") // CAM | CNC | DELIK — CNC ve delik satırları üstlerindeki cam satırına aittir
  free        Boolean @default(false) // bedelsiz: fiyat 0 kabul edilir
  // Katalogdaki cam (açıklama katalogla eşleştiyse) ve teklif anındaki kopyası
  glassProductId String?
  descriptionRo  String?  // camın Romence adı — Romence ekranda açıklama yerine gösterilir
  weightKgM2     Decimal? @db.Decimal(6, 2) // yüklemelerde ağırlık; teklifte görünmez
  // Fiyat tablosundaki liste fiyatı (satışçı bundan farklı fiyat girerse yöneticiye uyarı düşer)
  listPrice      Decimal? @db.Decimal(12, 2)
  // Müşteri fiyatı (yönetici girer; müşteri fiyat tablosundan gelebilir). unitPrice = satış fiyatı.
  offerPrice     Decimal? @db.Decimal(12, 2)
  // Profil teklifi satırı (kind = PROFIL): ürün ve birimi (CUTII, PUNGI, BARA, BUCATI); tutar = adet × fiyat
  profileProductId String?
  unitCode         String?
  loadedItems      LoadingConfirmationItem[] // bu satırdan onaylı yüklemelere alınan kopyalar
  // TELAFİ satırı (Aşama 9): bu satır bir telafi kararıyla eklendi (cam ve ona ait CNC / delik satırları). Teklifin yeni
  // sürümü açılınca işaret satırla birlikte taşınır. Satırın kendisi olağan teklif satırıdır (fiyat, yükleme, fatura aynı).
  compensationId   String?
  compensation     Compensation? @relation("CompensationLines", fields: [compensationId], references: [id], onDelete: SetNull)
  compensationsFrom Compensation[] @relation("CompensationSourceLine") // bu (kaynak) satır için açılan telafiler
  // Ayrılmış cam (karar 114): işlem (CNC / delik) eklemek için adetli satırdan ayrılan camlar AYNI ticari kalemdir.
  //   splitGroup — aynı kalemin satırlarını bağlayan anahtar (ayırmada verilir; boş = olağan satır)
  //   pieceBase  — satırın kalemdeki ilk camından önceki cam sayısı (5 → 4 + 1: 0 ve 4). m² ve tutar kalemin TOPLAM
  //                adedinden hesaplanıp satırlara bu sıraya göre paylaştırılır (server/orders/rules.js → offerLineTotals);
  //                böylece ayırma toplam m²'yi ve tutarı değiştirmez. Sunucu her kayıtta yeniden hesaplar (assignPieceBases).
  splitGroup       String?
  pieceBase        Int     @default(0)
  // Sandık bedeli (Paket 4): yöneticinin girdiği sandık parası satırı. Olağan bir adetli satırdır (tutar, fatura, yükleme
  // ve kârlılık aynı kuralla) — işaret yalnızca görünürlüğü belirler: satışa hiç gitmez, satışın kaydı satırı korur;
  // yönetici ve müşteri (denetimci de) görür. Yalnızca yönetici açar (server/orders/transitions.js → offerEdit).
  crateFee         Boolean @default(false)

  @@index([compensationId])
}

// Telafi / kırık cam kararı (Aşama 9, karar 108): var olan bir siparişin bir camının yeniden üretilmesi. Yüklenmeyen cam
// (NOT_LOADED) kaydından AYRI bir kavramdır: yüklemeden önce, sonra ya da teslimden haftalar sonra açılabilir. Kaynak
// teklif satırı ve sipariş DEĞİŞMEZ; telafi camı ya müşterinin ileri tarihli başka bir siparişine TELAFİ satırı olarak
// eklenir ya da yeni bir telafi siparişi (ABC124-T) açılır. Sonrası olağan iş akışıdır.
model Compensation {
  id             String   @id @default(cuid())
  requestKey     String   @unique // formun tek kullanımlık anahtarı: çift tıklama / yinelenen istek tek kayıt üretir
  // APPLIED: satırlar hedef siparişin teklifine yazıldı · PENDING: hedef siparişin teklifi müşteride ve kararı satış verdi —
  // yöneticinin onayını bekler (müşteriye giden teklifi yalnızca yönetici değiştirir) · REJECTED: yönetici reddetti
  status         String   @default("APPLIED")
  // Kaynak (değişmez)
  sourceOrderId  String
  sourceOrder    Order    @relation("CompensationSource", fields: [sourceOrderId], references: [id])
  sourceOfferId  String
  sourceLineId   String
  sourceLine     OfferLine @relation("CompensationSourceLine", fields: [sourceLineId], references: [id], onDelete: Restrict)
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  // Kaynak camın kopyası (liste ve geçmiş için; üretim bilgisi telafi satırlarındadır)
  description    String
  descriptionRo  String?
  enMm           Int?
  boyMm          Int?
  quantity       Int
  currency       String
  // Fiyat kararı. Yönetici MÜŞTERİ fiyatına karar verir (priceTier = CUSTOMER); satış müşteri fiyatını görmez, kendi
  // SATIŞ fiyatına karar verir (priceTier = SALES). Bedelsiz: müşteri fiyatı 0, fabrika maliyeti (unitCost) durur.
  priceMode      String   // NORMAL | FREE | CUSTOM
  priceTier      String   // CUSTOMER | SALES
  normalCost     Decimal  @db.Decimal(12, 2) // kaynak satırın satış fiyatı (= fabrika maliyeti)
  normalPrice    Decimal? @db.Decimal(12, 2) // kaynak satırın müşteri fiyatı
  unitCost       Decimal  @db.Decimal(12, 2) // telafi satırının satış fiyatı / maliyeti
  offerPrice     Decimal? @db.Decimal(12, 2) // telafi satırının müşteri fiyatı (boş: yönetici girecek)
  free           Boolean  @default(false)
  // Hedef
  destType       String   // EXISTING (müşterinin ileri tarihli siparişine eklendi) | NEW (yeni telafi siparişi)
  destOrderId    String?
  destOrder      Order?   @relation("CompensationDest", fields: [destOrderId], references: [id])
  loadingDay     DateTime? @db.Date // karar anında hedefin yükleme günü
  // Yüklenmeyen camla ilişki (isteğe bağlı): bu telafi, onaylı yüklemede yüklenmeyen şu kalemin yerine üretilir. Aynı
  // adet ayrıca ileri güne aktarılamaz (aktarım kapasitesinden düşülür) — aynı cam iki kez üretilmez.
  sourceItemId   String?
  sourceItem     LoadingConfirmationItem? @relation(fields: [sourceItemId], references: [id], onDelete: Restrict)
  notLoadedScope String?  // "<onay>|<kapsam>" (server/loading/confirmation.js → scopeOf)
  lines          OfferLine[] @relation("CompensationLines")
  createdById    String
  createdBy      User     @relation("CompensationCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  // Bekleyen kararın sonucu (yönetici)
  decidedById    String?
  decidedBy      User?    @relation("CompensationDecidedBy", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  decisionNote   String?

  @@index([sourceOrderId])
  @@index([destOrderId])
  @@index([notLoadedScope])
}

// Fiyat tabloları (Aşama 3b, karar 26): satışçıların teklife yazacağı liste fiyatları.
// Cam başına m² fiyatı; delik ve CNC için adet başına sabit fiyat.
enum PriceTableKind {
  SALES    // satışçıların liste fiyatları (satış fiyatı)
  CUSTOMER // müşteriye özel fiyatlar (yöneticinin müşteri fiyatı)
}

model PriceTable {
  id        String   @id @default(cuid())
  kind      PriceTableKind @default(SALES)
  name      String   @unique
  currency  String   @default("EUR")
  holePrice Decimal? @db.Decimal(12, 2) // delik başına
  cncPrice  Decimal? @db.Decimal(12, 2) // CNC işlemi başına
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false) // ataması olmayan satışçılar bunu kullanır (en fazla bir tablo)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  items     PriceTableItem[]
  users     User[]      // SALES: atanan satışçılar
  customers Customer[]  // CUSTOMER: bu fiyatları kullanan müşteri firmaları
  offers    Offer[]
}

model PriceTableItem {
  id             String       @id @default(cuid())
  tableId        String
  table          PriceTable   @relation(fields: [tableId], references: [id], onDelete: Cascade)
  glassProductId String
  glassProduct   GlassProduct @relation(fields: [glassProductId], references: [id], onDelete: Cascade)
  unitPrice      Decimal      @db.Decimal(12, 2) // m² fiyatı
  updatedAt      DateTime     @default(now()) @updatedAt

  @@unique([tableId, glassProductId])
}

// Yöneticinin "Önemli kararlar" listesi: bir insan kararı bekleyen durumlar
// (ör. satışçı liste fiyatını değiştirdi). Yönetici "Gördüm" deyince kapanır; silinmez.
model AdminAlert {
  id           String    @id @default(cuid())
  type         String    // PRICE_OVERRIDE
  orderId      String?
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  offerId      String?
  offer        Offer?    @relation(fields: [offerId], references: [id], onDelete: SetNull)
  details      Json
  // Aynı durum için ikinci kayıt açılmasın (Paket 10, karar 206): ör. "fin:<zincir>:<tür>:<tutarlar>", "fgo-uncertain:<iş>".
  // Boş = tekilleştirme yok (eski türler).
  dedupeKey    String?   @unique
  createdById  String?
  createdBy    User?     @relation("AlertCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("AlertResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([resolvedAt, createdAt])
}

model Price {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  amount    Decimal  @db.Decimal(12, 2) // "Satış Tutarı" — sistem yöneticisi girer
  setById   String
  setBy     User     @relation("PriceSetBy", fields: [setById], references: [id])
  setAt     DateTime @default(now())
}

// ---------------------------------------------------------
// ÇİZİM
// ---------------------------------------------------------

enum DrawingSource {
  FABRIKA // "Çizim işleri — fabrika çizecek"
  // Müşteri hazır çizim (DWG/DXF) gönderdi — karar 167: çizimcinin müşterinin dosyası hakkındaki KARAR kaydı. Dosya
  // satırı (DrawingFile) yoktur: dosyalar müşterinin sipariş dosyalarıdır (OrderFile), incelenenler sourceFiles'ta.
  // Durum = karar: BEKLIYOR (düzeltilmiş dosya geldi, karar bekliyor) · ONAYLANDI (üretime hazır) · REVIZYON_ISTENDI
  // (çizim hatalı) · YAPILIYOR (fabrika çizecek: "Çizimi Güncelle" ya da müşterinin fabrika çizimi talebi).
  MUSTERI_DXF_DWG
}

// Revizyon kaydının türü (karar 167): müşterinin revizyon talebi ya da çizimcinin "çizim hatalı" açıklaması
enum DrawingRevisionKind {
  TALEP  // müşterinin revizyon talebi (numaralı maddeler, karar 162)
  HATALI // fabrika: müşterinin DWG/DXF çizimi hatalı — açıklama müşteriye (Romence çevirisiyle) gider
}

enum DrawingStatus {
  BEKLIYOR
  YAPILIYOR
  TASLAK           // çizimci dosyaları yükledi, henüz müşteriye göndermedi (müşteri görmez)
  ONAY_BEKLIYOR    // müşteriye gönderildi
  ONAYLANDI
  REVIZYON_ISTENDI
  GERI_CEKILDI     // çizimci, müşteri karar vermeden geri çekti (gerekçeyle)
}

// Çizim sürümü. Sürümler silinmez ve üzerine yazılmaz; müşteriye gönderilen sürümün dosyaları değişmez.
// Akış: TASLAK (dosyalar yüklenir) → "Müşteriye gönder" (tüm dosyalar virüs taramasından temiz geçmiş olmalı)
// → ONAY_BEKLIYOR → ONAYLANDI | REVIZYON_ISTENDI | GERI_CEKILDI.
model Drawing {
  id           String        @id @default(cuid())
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id])
  source       DrawingSource @default(FABRIKA)
  version      Int           @default(1)
  files        DrawingFile[]
  noteCustomer String?       // müşteriye görünen sürüm notu
  noteInternal String?       // yalnızca iç ekip
  sentAt       DateTime?
  sentById     String?
  sentBy       User?         @relation("DrawingSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?     // müşterinin onay / revizyon kararı
  decidedById  String?
  decidedBy    User?         @relation("DrawingDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  withdrawnAt  DateTime?
  withdrawReason String?
  // Eski düzen (sürüm başına tek dosya); prisma/seed/steps/drawing-files.mjs DrawingFile'a taşır
  fileUrl      String?
  fileName     String?
  fileSize     Int?
  mime         String?
  checksum     String?
  scanStatus   FileScanStatus @default(PENDING)
  scanSignature String?
  scannedAt    DateTime?
  status       DrawingStatus @default(BEKLIYOR)
  uploadedById String
  uploadedBy   User          @relation("DrawingUploadedBy", fields: [uploadedById], references: [id])
  revisions    DrawingRevision[]
  createdAt    DateTime      @default(now())
  // Müşterinin DWG/DXF çizimi (source MUSTERI_DXF_DWG, karar 167): kararın verildiği sipariş dosyaları — değişmez anlık
  // kopya [{ id, name, checksum }]. Fabrika sürümünde boş.
  sourceFiles  Json?
  // Müşteriye görünen sürüm notunun (noteCustomer) otomatik çevirisi (karar 168 — not çevirisiyle aynı kural ve alanlar;
  // server/notes/translation.js → translateDrawingNote): sürüm müşteriye GÖNDERİLİRKEN bir kez çevrilir ve burada
  // saklanır; sayfa açılışı / yenileme çeviri yapmaz. Gönderen iç ekip → Romence.
  translation       String?
  translationLang   String?
  translationStatus NoteTranslationStatus?
  translationError  String?
  translationAt     DateTime?

  @@unique([orderId, version])
}

// Çizim sürümünün dosyaları (PDF, DWG, DXF…). Her dosya yüklenirken virüs taramasından geçer.
model DrawingFile {
  id            String         @id @default(cuid())
  drawingId     String
  drawing       Drawing        @relation(fields: [drawingId], references: [id], onDelete: Restrict)
  name          String
  storageKey    String
  size          Int
  mime          String?
  checksum      String?
  scanStatus    FileScanStatus @default(PENDING)
  scanSignature String?
  scannedAt     DateTime?
  uploadedById  String
  uploadedBy    User           @relation("DrawingFileUploadedBy", fields: [uploadedById], references: [id])
  createdAt     DateTime       @default(now())

  @@index([drawingId])
  @@index([scanStatus])
}

model DrawingRevision {
  id            String   @id @default(cuid())
  drawingId     String
  drawing       Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  // TALEP: müşterinin revizyon talebi · HATALI: çizimcinin "müşterinin DWG/DXF çizimi hatalı" açıklaması (karar 167)
  kind          DrawingRevisionKind @default(TALEP)
  requestedById String   // yazan: müşteri (TALEP) ya da iç ekip (HATALI)
  comment       String   // müşterinin revizyon notu: numaralı maddeler "1. …\n2. …" (karar 162; eski kayıtlarda serbest metin) · HATALI: çizimcinin açıklaması
  annotations   Json?    // çizim üstü işaretler (server/orders/annotations.js): iğne, dikdörtgen, serbest, metin
  createdAt     DateTime @default(now())
  // Revizyon notunun otomatik çevirisi (karar 163, 168 — not çevirisiyle aynı kural ve alanlar; server/notes/translation.js →
  // translateRevision): not yazılırken BİR KEZ çevrilir ve burada saklanır; sayfa açılışı / yenileme çeviri yapmaz.
  // Yön yazanın rolünden: müşteri → Türkçe (iç ekip için), iç ekip (HATALI açıklaması) → Romence (müşteri için).
  translation       String?
  translationLang   String?
  translationStatus NoteTranslationStatus?
  translationError  String?
  translationAt     DateTime?
}

// ---------------------------------------------------------
// SANDIK (paketleme)
// ---------------------------------------------------------

// Sandık: yükleme sekmesinde, yükleme günü + müşteri için girilir (satış ya da yönetici).
// Sandık numarası o gün içinde tektir (müşteriler arasında da); hangi siparişlerin camlarını taşıdığı CrateOrder'da.
model Crate {
  id          String    @id @default(cuid())
  shipDay     DateTime? @db.Date // yükleme günü
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  orderId     String?   // eski düzen: sipariş başına sandık (prisma/seed/steps/crates.mjs yeni düzene taşır)
  order       Order?    @relation(fields: [orderId], references: [id])
  crateNo     Int
  lengthMm    Int?      // uzunluk
  widthMm     Int?      // genişlik
  heightMm    Int?      // yükseklik
  dimensions  String?   // eski düzende serbest metin ölçü
  netAgirlik  Decimal?  @db.Decimal(10, 2)
  brutAgirlik Decimal?  @db.Decimal(10, 2)
  daraKg      Decimal   @default(50) @db.Decimal(6, 2) // brüt girilmezse net + dara
  note        String?
  orders      CrateOrder[]
  updatedAt   DateTime  @default(now()) @updatedAt
  updatedById String?
  updatedBy   User?     @relation("CrateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([shipDay, customerId])
}

// Sandıktaki sipariş = FİZİKSEL yerleşim. Sipariş, sandığın sahibi (Crate.customerId — fiziksel ev sahibi) olmayan bir
// müşterinin olabilir (Aşama 7E): ticari sahiplik, fatura ve muhasebe her zaman siparişin kendi müşterisindedir;
// bu ilişki hiçbirini değiştirmez. Yalnızca aynı yükleme gününün sandığına atanabilir (server/loading/crates.js).
model CrateOrder {
  crateId String
  crate   Crate  @relation(fields: [crateId], references: [id], onDelete: Cascade)
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@id([crateId, orderId])
  @@index([orderId])
}

// ---------------------------------------------------------
// YÜKLEME / TAKVİM
// ---------------------------------------------------------

enum ShipmentStatus {
  PLANLANDI
  BEKLEMEDE // "Beklemeye alınanlar bu listede görünmez"
  YUKLENDI
  IPTAL
}

model Shipment {
  id        String         @id @default(cuid())
  date      DateTime       // Yükleme günü
  status    ShipmentStatus @default(PLANLANDI)
  orders    Order[]
  createdAt DateTime       @default(now())
}

// ---------------------------------------------------------
// SÜREÇ KURALLARI (Ayarlar / Onay politikaları / SLA)
// ---------------------------------------------------------

model SlaPolicy {
  id          String   @id @default(cuid())
  stageName   String   // "İnceleniyor", "Çizim Yapılıyor" vb.
  maxHours    Int
  escalateTo  String?  // eskalasyon rolü/kullanıcı id
  isActive    Boolean  @default(true)
}

model ApprovalPolicy {
  id           String  @id @default(cuid())
  name         String
  maxRevisions Int     @default(3)
  description  String?
  isActive     Boolean @default(true)
}

// ---------------------------------------------------------
// BİLDİRİM
// ---------------------------------------------------------

// Uygulama içi bildirim (zil): alıcı başına bir satır (Aşama 8, karar 107). Olaylar NotificationOutbox'tan işçide
// dağıtılır (server/notifications/inapp.js); metin, alıcının göreceği kadar bilgiyle saklanır (satış / çizim için firma
// adı MASKELİ yazılır) ve ekranda kullanıcının diliyle type + params'tan üretilir.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String   // yedek metin (Romence): type bilinmiyorsa gösterilir
  link      String?  // uygulama içi adres; sayfa kendi yetki denetimini yapar (bağlantı yetki değildir)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  type      String?  // olay: ORDER_OFFER_SENT, LOADING_REPLANNED, FGO_FAILED … (başlık i18n'den)
  params    Json?    // metnin değerleri: orderNo, firm (alıcıya göre maskeli), date, qty, ref, amount, aud
  orderId   String?
  // Olayın kimliği: "outbox:<NotificationOutbox.id>" ya da işe özgü anahtar. Aynı olay aynı kullanıcıya bir kez
  // (işçi yeniden denese / iki işçi aynı anda çalışsa da) — veritabanında benzersiz.
  dedupeKey String?
  readAt    DateTime?

  @@unique([userId, dedupeKey])
  @@index([userId, isRead, createdAt])
}

// Bildirim kuyruğu (ADR 0006): iş akışı işlemi aynı veritabanı işleminde buraya yazar; gönderim ayrı çalışır (Aşama 8).
enum OutboxStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model NotificationOutbox {
  id          String       @id @default(cuid())
  type        String       // ORDER_SENT_TO_DRAWING, ORDER_OFFER_SENT, FILE_INFECTED...
  orderId     String?
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payload     Json?
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  availableAt DateTime     @default(now())
  sentAt      DateTime?
  createdAt   DateTime     @default(now())
  // Uygulama içi bildirime dağıtıldığı an (e-posta durumundan bağımsız ayrı kanal); boş = henüz dağıtılmadı
  inAppAt     DateTime?

  @@index([status, availableAt])
  @@index([inAppAt])
}

// Entegrasyon ayarları (yönetici → Entegrasyonlar). Sır içermez; sırlar yalnızca sunucudaki .env'de.
model IntegrationSetting {
  key         String   @id // "antivirus"
  value       Json
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------
// DENETİM KAYDI — sadece okunur, hiçbir kayıt silinemez
// ---------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  actorRole  String?  // işlemi yapanın o anki rolü
  ip         String?
  action     String   // "ORDER_TRANSITION", "PRICE_SET", "USER_LOGIN" vb.
  entityType String   // "Order", "Drawing", "Price"...
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ---------------------------------------------------------
// PROFİL SİPARİŞİ (Aşama 6)
// ---------------------------------------------------------
// Satış ve çizim hiç devreye girmez. Akış (ProfileOrder.stage):
//   FIYAT_BEKLIYOR → (yönetici fiyatlar, gönderir) TEKLIF_GONDERILDI → (müşteri onaylar: alış tarihi, telefon, plaka) ONAYLANDI
//   → PROFORMA → ("Ödeme alındı": hemen depoya gider; ya da ödemeden önce "Siparişi depoya gönder") DEPODA
//   → TESLIM_EDILDI → FATURALANDI. Ödeme ayrı bir bilgidir (paidAt): depoya elle gönderilmiş siparişte sonradan girilebilir.
// Order.status genel listeler içindir: YENI (fiyat bekliyor) · HAZIRLANIYOR (teklif…depo) · ARSIVLENDI (faturalandı) · IPTAL.

enum ProfileStage {
  FIYAT_BEKLIYOR
  TEKLIF_GONDERILDI
  ONAYLANDI
  PROFORMA
  DEPODA
  TESLIM_EDILDI
  FATURALANDI
}

// Katalog kategorisi (GARNITURI, PLASTICE, PROFILE ALUMINIU, ACCESORII…). Silinmez, pasif yapılır.
model ProfileCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  nameRo    String
  nameTr    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  products  ProfileProduct[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Profil ürünü. code kalıcıdır (değişmez). Liste fiyatı EUR, KDV (TVA) hariç. Pasif ürün müşteri formunda görünmez.
model ProfileProduct {
  id         String   @id @default(cuid())
  code       String   @unique
  categoryId String
  category   ProfileCategory @relation(fields: [categoryId], references: [id])
  nameRo     String
  nameTr     String
  unitCode   String   // CUTII | PUNGI | BARA | BUCATI (prisma/seed/data/units.js)
  imageId    String?  // güncel görsel (yalnızca giriş yapmış kullanıcıya verilir)
  image      ProfileImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  listPrice  Decimal? @db.Decimal(12, 2)
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  metadata   Json?    // ileride ek bilgiler için
  // Paket içeriği (Paket 5, karar 175): BİR satış biriminin içindeki miktar — kutu: 137 m conta, bar: profil boyu (m),
  // poşet: adet. Hesaplayıcı yalnızca bunu kullanır; boşsa ürün hesaplanmaz (yönetici tamamlar, değer tahmin edilmez).
  packContent   Decimal?        @db.Decimal(12, 3)
  packMeasure   ProfileMeasure?
  // Kritik stok eşiği (satış birimi; karar 177): stok ≤ eşik → "Kritik stok" (tek açık uyarı); boş = eşik yok
  criticalStock Int?
  // Tedarik (Paket 6, karar 180 — yalnızca yönetici, SUPPLIER_MANAGE): ürünün tedarikçisi, ALIŞ fiyatı (müşterinin liste
  // fiyatından tamamen ayrı), alış para birimi ve sipariş birimi (boş = satış birimi). Fiyat yoksa tedarikçi siparişinde
  // "fiyat yok" görünür — fiyat uydurulmaz.
  supplierId       String?
  supplier         Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchasePrice    Decimal?  @db.Decimal(12, 4)
  purchaseCurrency String?
  purchaseUnit     String?
  supplierLines    SupplierOrderLine[]
  prices     ProfilePriceItem[]
  stockMoves StockMovement[]
  calcItems  ProfileCalcItem[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([categoryId, sortOrder])
}

// ---------- Profil hesaplayıcı (Paket 5, karar 175–176) ----------
// Yönetici yapılandırır; değerler tahmin edilmez. Müşteri sistem + renk + cam kalınlığı + toplam metre girer; her kalemin
// (slot) koşula uyan TEK satırı seçilir ve miktar = yukarı yuvarla(metre × tüketim / paket içeriği) (server/profile/calculator.js).
// Sipariş bu kayıtlara bağlanmaz: hesap sonucu formdaki adetlere aktarılır, sipariş kalemleri her zamanki gibi kopyadır.

// İçeriğin ölçüsü: metre (profil boyu, conta kutusu) ya da adet (poşetteki parça)
enum ProfileMeasure {
  M
  BUC
}

// Hesap sisteminin türü (karar 203): korkuluk profili ya da küpeşte
enum ProfileSystemKind {
  PROFILE
  HANDRAIL
}

// Profil rengi (hesaplayıcının renk seçimi)
enum ProfileColor {
  RAL7016
  ELOXAT
}

// Geçerli cam kalınlıkları (yönetici tanımlar; silinmez, pasif yapılır)
model ProfileGlassThickness {
  id        String   @id @default(cuid())
  mm        Decimal  @unique @db.Decimal(6, 2)
  // Müşterinin gördüğü ad (ör. "6+6" — lamine cam; boş = "12,76 mm"; karar 203)
  label     String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  calcItems ProfileCalcItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Hesaplama sistemi (ör. MR23 el tutamağı). Silinmez, pasif yapılır. RM29 gibi yeni sistemleri yönetici açar.
model ProfileSystem {
  id        String   @id @default(cuid())
  code      String   @unique
  nameRo    String
  nameTr    String
  // Müşteri hesaplayıcısındaki yeri (karar 203): korkuluk profili (FBL90 / FBL115) ya da küpeşte (MR23 / RM29) — iki AYRI
  // seçim. Boş = müşteri hesaplayıcısında görünmez (yönetici türünü seçince görünür).
  kind      ProfileSystemKind?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  items     ProfileCalcItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Sistemin bir satırı: kalem (slot) + ürün (boş = bu koşulda gerekmez) + koşul (renk / cam kalınlığı; boş = hepsi) +
// 1 m korkuluk için tüketim (ürünün ölçüsünde). Aynı kalemin satırları birbirinin seçeneğidir; koşulları çakışmaz.
model ProfileCalcItem {
  id          String   @id @default(cuid())
  systemId    String
  system      ProfileSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  slot        String
  productId   String?
  product     ProfileProduct? @relation(fields: [productId], references: [id], onDelete: Restrict)
  color       ProfileColor?
  thicknessId String?
  thickness   ProfileGlassThickness? @relation(fields: [thicknessId], references: [id], onDelete: Restrict)
  perMeter    Decimal? @db.Decimal(12, 4)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([systemId, sortOrder])
  @@index([productId])
  @@index([thicknessId])
}

// Ürün görseli: değişmez kayıt (yeni görsel yeni satırdır; eski siparişler eski görseli göstermeye devam eder).
// Küçük görseller (en fazla 2 MB, JPG/PNG) veritabanında durur: yedekle birlikte taşınır, PDF üretimi dosya sistemine bağlı değildir.
model ProfileImage {
  id        String   @id @default(cuid())
  data      Bytes
  mime      String   // image/jpeg | image/png
  size      Int
  checksum  String
  name      String?
  createdById String?
  createdAt DateTime @default(now())
  products  ProfileProduct[]
}

// Müşteriye özel profil fiyat tablosu: birden çok firma aynı tabloyu kullanabilir.
model ProfilePriceTable {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  items     ProfilePriceItem[]
  customers Customer[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ProfilePriceItem {
  id        String            @id @default(cuid())
  tableId   String
  table     ProfilePriceTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  productId String
  product   ProfileProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitPrice Decimal           @db.Decimal(12, 2)
  updatedAt DateTime          @default(now()) @updatedAt

  @@unique([tableId, productId])
}

// Profil siparişinin iş akışı ve teslim bilgileri (Order ile bire bir).
model ProfileOrder {
  id               String       @id @default(cuid())
  orderId          String       @unique
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage            ProfileStage @default(FIYAT_BEKLIYOR)
  stageSince       DateTime     @default(now())
  // Müşteri onayı (müşteriye gönderilmiş son teklif)
  approvedAt       DateTime?
  approvedById     String?
  approvedOfferId  String?
  // Teslim bilgileri: depo e-postası gidene kadar müşteri değiştirebilir
  pickupDate       DateTime?    @db.Date
  contactPhone     String?
  vehiclePlate     String?
  // Proforma / ödeme / depo / teslim / fatura
  proformaNo       String?
  proformaAt       DateTime?
  paidAt           DateTime?    @db.Date
  warehouseSentAt  DateTime?
  stockDeducted    Boolean      @default(false)
  // Depo bağlantısı (e-postadaki tek kullanımlık adres): yalnızca özeti saklanır
  depotTokenHash   String?      @unique
  depotTokenExpiresAt DateTime?
  deliveredAt      DateTime?
  deliveredVia     String?      // DEPOT_LINK | ADMIN
  invoiceNo        String?
  invoicedAt       DateTime?
  // FGO (Aşama 6b): RON belge kuru = proforma günündeki BT EUR satış kuru; fatura aynı kurla kesilir
  fxRate           Decimal?     @db.Decimal(10, 4) // uygulanan kur (proformada bir kez yazılır; fatura aynı kurla)
  fxDate           DateTime?    @db.Date
  fxSource         String?      // BNR | MANUAL | MANUAL_DAY
  // Kur kaydının kalanı (karar 96, 98; GlassBilling ile aynı alanlar)
  fxPolicy         String?
  fxCurrency       String?
  fxBaseRate       Decimal?     @db.Decimal(12, 6)
  fxMarkupPercent  Decimal?     @db.Decimal(6, 3)
  fxSourceDate     DateTime?    @db.Date
  fxResolvedAt     DateTime?
  fxManual         Boolean?
  proformaLink     String?      // FGO'nun belge bağlantısı
  proformaAmount   Decimal?     @db.Decimal(12, 2) // RON, TVA hariç
  invoiceLink      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt

  @@index([stage])
}

// Teslimat fotoğrafı (Paket 8, karar 195): depo bağlantısından ya da yöneticinin yüklediği fotoğraf. Dosyanın kendisi OrderFile'dadır
// (source DELIVERY_PHOTO: mevcut depolama, içerik denetimi, antivirüs, kota, yükleyen ve yükleme anı); bu satır teslimat bağını
// ve tekrar engelini taşır: aynı siparişe aynı içerik (SHA-256) ikinci kez kaydedilmez — yeniden yükleme ya da eşzamanlı iki
// istek tek kayıt bırakır. Fotoğrafı siparişin müşterisi ve siparişi gören iç ekip görür (/dosya/teslimat/<id>). Değişmez,
// silinmez (veritabanı tetikleyicisi).
model DeliveryPhoto {
  id        String    @id @default(cuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileId    String    @unique
  file      OrderFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  checksum  String
  via       String    // DEPOT_LINK | ADMIN
  createdAt DateTime  @default(now())

  @@unique([orderId, checksum])
  @@index([orderId, createdAt])
}

// Teslimat raporu (Paket 8, karar 196): depo bağlantısı ya da yönetici oluşturur. Oluşturulduğu andaki KOPYADIR (sipariş no, firma,
// teslim günü, teslim edilen ürünler ve adetler, durum, açıklama, fotoğraflar — data); sonradan değişmez (veritabanı tetikleyicisi
// UPDATE / DELETE'i reddeder). PDF istenince bu kopyadan ortak PDF altyapısıyla üretilir; erişim siparişi görme yetkisine bağlıdır
// (/dosya/rapor/<id>; müşteri yalnızca kendi siparişi) — süreli bağlantı yoktur. Her oluşturma yeni sürümdür; eskiler kalır.
model DeliveryReport {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  revision    Int
  stage       ProfileStage // rapor anındaki adım (DEPODA | TESLIM_EDILDI | FATURALANDI)
  deliveryDay DateTime?    @db.Date
  deliveredAt DateTime?
  note        String?
  data        Json
  fingerprint String       // aynı içerik (adım, gün, açıklama, fotoğraflar) art arda iki kez rapor olmaz
  requestKey  String?      @unique // tek kullanımlık form anahtarı: çift tıklama tek rapor
  via         String       // DEPOT_LINK | ADMIN
  createdById String?
  createdBy   User?        @relation("DeliveryReportCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  @@unique([orderId, revision])
}

// Çalışma takvimi istisnası (Paket 8, karar 192): yöneticinin bir günü elle AÇIK ya da KAPALI işaretlemesi — otomatik kuraldan
// (hafta sonu, resmî tatil: server/calendar/holidays.js) önce gelir. Takvim + gün başına tek karar; kaldırılınca otomatik kurala
// döner. Değişikliklerin geçmişi denetim kaydındadır (WORK_CALENDAR_OVERRIDE). İki takvim birbirinden bağımsızdır.
model WorkCalendarOverride {
  id          String       @id @default(cuid())
  calendar    WorkCalendar
  day         DateTime     @db.Date
  open        Boolean
  note        String?
  updatedById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([calendar, day])
}

enum WorkCalendar {
  RO_DEPOT   // Romanya deposu (Europe/Bucharest) — profil teslim günü
  TR_FACTORY // Türkiye fabrikası (Europe/Istanbul) — tedarikçi tahmini yükleme uyarısı
}

// Müşterinin istediği ürünler: sipariş anındaki kopya (katalog sonradan değişse de sipariş değişmez).
model ProfileOrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  code         String
  nameRo       String
  nameTr       String
  unitCode     String
  categoryCode String
  imageId      String?  // sipariş anındaki görsel (görsel değiştirilse de eskisi silinmez)
  qty          Int
  sortOrder    Int             @default(0)

  @@index([orderId])
}

enum StockMoveKind {
  GIRIS    // mal girişi (+)
  CIKIS    // depoya giden sipariş (−)
  SAYIM    // sayım düzeltmesi (±)
  IADE     // iptal edilen siparişin geri alınan çıkışı (+)
}

// Stok hareketleri: yalnızca eklenir (silinmez, düzeltilmez). Ürünün stoğu = hareketlerin toplamı.
model StockMovement {
  id          String         @id @default(cuid())
  productId   String
  product     ProfileProduct @relation(fields: [productId], references: [id])
  qty         Int            // + giriş, − çıkış
  kind        StockMoveKind
  orderId     String?
  order       Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  note        String?
  createdById String?
  createdAt   DateTime       @default(now())

  @@index([productId])
  @@index([orderId])
}

// ---------------------------------------------------------
// MUHASEBE (yalnızca yönetici)
// ---------------------------------------------------------

// FGO'da kesilen belgeler (proforma / fatura) ve FGO'dan okunan ödeme durumu. Belge kesilince kaydedilir
// (server/profile/transitions.js → fgo_proforma / fgo_invoice); "FGO ile güncelle" getstatus ile tutarı ve ödeneni yeniler.
model FgoDocument {
  id         String    @id @default(cuid())
  // Belge ya bir siparişe (sipariş başına belgeler) ya da bir müşteri partisine (BillingBatch: birden çok sipariş, tek
  // belge — Aşama 7D-2) aittir; ikisi birden dolu olmaz. Parti belgesi rastgele bir siparişe bağlanmaz.
  orderId    String?
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  batchId    String?   @unique // parti başına tek FGO belgesi
  batch      BillingBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  kind       String    // PROFORMA | ADVANCE (avans faturası, cam) | INVOICE
  series     String
  number     String
  issuedAt   DateTime
  link       String?
  currency   String    @default("RON")
  total      Decimal?  @db.Decimal(14, 2) // FGO "Valoare" (TVA dahil); ilk kontrolden önce boş
  paid       Decimal?  @db.Decimal(14, 2) // FGO "ValoareAchitata"
  checkedAt  DateTime?
  checkError String?
  // Sipariş başına aynı türden kaçıncı belge (Aşama 7F-1): proforma ve kapanış faturası tektir (1); avans faturası
  // birden çok olabilir (proformaya sonradan gelen her tahsilat için bir tane: 1, 2, …).
  seq        Int       @default(1)
  // Yalnızca sipariş başına ADVANCE: bu avansın karşıladığı tahsilat (TVA dahil, istenen tutar). "Avansı kesilen" toplam
  // bundan hesaplanır; FGO'nun gösterdiği toplam (total) kuruş yuvarlamasıyla farklı olabilir.
  advanced   Decimal?  @db.Decimal(14, 2)
  // Yalnızca ADVANCE (Paket 10, karar 207): avansın dayanağı — FGO (FGO'nun proformada gösterdiği tahsilat), MANUAL
  // (yöneticinin elle kaydettiği ödeme) ya da FGO_MANUAL (ikisi aynı tutarı gösteriyordu). Eski kayıtlarda boş (= FGO).
  basis      String?
  createdAt  DateTime  @default(now())
  coveredPayments ManualPayment[] @relation("ManualPaymentAdvanceDoc")

  @@unique([series, number])
  @@unique([orderId, kind, seq]) // sipariş başına her türden sıra başına tek belge (çift kesim veritabanında da engellenir)
  @@index([orderId])
}

// Müşteri düzeyinde belge partisi (Aşama 7D-2, karar 100): bir müşteri + seçilen yükleme günleri + birden çok sipariş
// → TEK FGO belgesi. Parti, yöneticinin onayladığı ticari içeriğin (siparişler, satırlar, tutarlar, kur) değişmez
// kopyasıdır: sonradan yükleme günü, teklif, fiyat tablosu, kur kaynağı ya da müşterinin kur politikası değişse de
// belge bu kayıttan okunur / kesilir. Türler (karar 100–101):
//   PROFORMA — yükleme öncesi müşteri proforması (seçilen yükleme günleri)
//   ADVANCE  — müşteri proformasına gelen tahsilatın avans faturası (parentId = proforma partisi)
//   INVOICE  — onaylı yüklemeden müşteri faturası (confirmationId; proforma zincirindeyse parentId = proforma partisi)
// Satırlar ve siparişler yalnızca eklenir; partinin kendisinde yalnızca durum değişir.
enum BillingBatchStatus {
  PENDING // kuyrukta: FGO belgesi kesilecek
  ISSUED  // FGO belgesi kesildi (FgoDocument.batchId)
  FAILED  // FGO kesin reddetti / denemeler bitti: yönetici yeniden dener ya da vazgeçer
  VOID    // geçersiz: yönetici vazgeçti ya da belge FGO'da silindi; siparişler yeniden uygun
}

model BillingBatch {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  kind         String   // PROFORMA | ADVANCE | INVOICE
  status       BillingBatchStatus @default(PENDING)
  // Belge zinciri: avans ve fatura partilerinde kaynak proforma partisi (kur ve avans düşümü bu zincirden)
  parentId     String?
  parent       BillingBatch?  @relation("BillingBatchChain", fields: [parentId], references: [id], onDelete: Restrict)
  children     BillingBatch[] @relation("BillingBatchChain")
  // Tekrar engeli (veritabanında): parti etkinken dolu, geçersiz olunca boş.
  //   INVOICE: "INVOICE:<onay>:<müşteri>:<para birimi>:<zincir>" · ADVANCE: "ADVANCE:<proforma partisi>:<önceki avans toplamı>"
  uniqueKey    String?  @unique
  currency     String   // siparişlerin (tekliflerin) para birimi; parti tek para birimlidir. FGO belgesi RON.
  loadingDays  DateTime[] @db.Date // yöneticinin seçtiği yükleme günleri (değişmez)
  selectionKey String   // içeriğin parmak izi: önizlenen = kesilen
  sourceTotal  Decimal  @db.Decimal(14, 2) // TVA hariç, kaynak para biriminde
  ronNet       Decimal  @db.Decimal(14, 2) // TVA hariç, RON (uygulanan kurla; FGO'ya giden satırların toplamı)
  // Kur kaydı (karar 96 ile aynı alanlar): parti oluşturulurken bir kez çözülür, sonra yeniden çözülmez
  fxRate          Decimal   @db.Decimal(10, 4)
  fxDate          DateTime  @db.Date
  fxSource        String
  fxPolicy        String
  fxCurrency      String
  fxBaseRate      Decimal   @db.Decimal(12, 6)
  fxMarkupPercent Decimal?  @db.Decimal(6, 3)
  fxSourceDate    DateTime  @db.Date
  fxResolvedAt    DateTime
  fxManual        Boolean
  // INVOICE: faturanın kaynağı olan onaylı yükleme (yalnızca LOADED kalemler)
  confirmationId String?
  confirmation   LoadingConfirmation? @relation(fields: [confirmationId], references: [id], onDelete: Restrict)
  createdById  String
  createdBy    User     @relation("BillingBatchCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  issuedAt     DateTime?
  lastError    String?
  voidedAt     DateTime?
  voidReason   String?
  // Yalnızca ADVANCE partisi (Paket 10, karar 207): FGO | MANUAL | FGO_MANUAL (FgoDocument.basis ile aynı)
  basis        String?
  orders       BillingBatchOrder[]
  lines        BillingBatchLine[]
  document     FgoDocument?
  manualPayments  ManualPayment[] @relation("ManualPaymentBatch")
  coveredPayments ManualPayment[] @relation("ManualPaymentAdvanceBatch")

  @@index([customerId])
  @@index([status])
}

// Partinin kaynak siparişleri: sipariş no, o anki planlanan yükleme günü, kullanılan teklif sürümü ve tutarı.
model BillingBatchOrder {
  id           String   @id @default(cuid())
  batchId      String
  batch        BillingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderNo      String
  offerId      String?  // proforma: müşteriye gönderilmiş teklif sürümü (kopyanın kaynağı); fatura: kaynak onay kalemleridir
  loadingDay   DateTime @db.Date // parti oluşturulurkenki planlanan yükleme günü
  sourceAmount Decimal  @db.Decimal(14, 2)
  // Çift faturalama engeli (veritabanında): parti etkinken "<kind>:<orderId>", parti geçersiz olunca boş.
  // Aynı sipariş aynı türden iki etkin partide olamaz.
  activeKey    String?  @unique
  // Müşteri faturası (INVOICE): fatura, onayın hangi düzeltme sırasındaki yüklenen kapsamından kesildi (0 = düzeltmesiz).
  // Sonraki bir düzeltme faturalanan kapsamı değiştirdiyse fark buradan bulunur (server/glass/invoice-batch.js → orderImpacts).
  loadingRevision Int   @default(0)

  @@unique([batchId, orderId])
  @@index([orderId])
}

// Partinin ticari satırları = FGO belgesine yazılan satırlar (açıklamada kaynak sipariş no'su).
model BillingBatchLine {
  id          String   @id @default(cuid())
  batchId     String
  batch       BillingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  orderId     String?  // kaynak sipariş; avans ve avans düşümü satırında boş
  sortOrder   Int
  name        String   // "Comanda ABC001 — Sticlă securizată 10 mm"
  unit        String   // FGO birimi (mp | buc)
  quantity    Decimal  @db.Decimal(12, 3)
  pieces      Int?     // fatura: yüklenen adet (bilgi; FGO'ya miktar olarak m² gider)
  unitPrice   Decimal? @db.Decimal(12, 2) // kaynak para biriminde, TVA hariç (proforma satırı: RON = birim × kur)
  amount      Decimal? @db.Decimal(14, 2) // kaynak para biriminde satır tutarı
  // RON satırlar: fatura cam satırı (TVA hariç / dahil toplam; FGO'ya PretTotal), avans ve avans düşümü (birim fiyat)
  ronUnit     Decimal? @db.Decimal(14, 2)
  ronNet      Decimal? @db.Decimal(14, 2)
  ronGross    Decimal? @db.Decimal(14, 2)
  refBatchId  String?  // avans düşümü satırı: düşülen avans partisi (avansın ne kadarının kullanıldığı buradan)

  @@index([batchId])
}

// Cam siparişi FGO belgeleri (Aşama: cam FGO): kur ve elle girilen ödeme. Belgelerin kendisi FgoDocument'te
// (PROFORMA → ADVANCE (avans faturası) → INVOICE). Müşteri onayı yok; sipariş durumu değişmez.
model GlassBilling {
  id         String    @id @default(cuid())
  orderId    String    @unique
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fxRate     Decimal?  @db.Decimal(10, 4) // proforma kuru = uygulanan (son) kur (avans ve kapanış faturası da bunu kullanır)
  fxDate     DateTime? @db.Date
  fxSource   String?   // BNR | MANUAL | MANUAL_DAY
  // Kur kaydının kalanı (karar 96): belge kesilirken çözücünün döndürdüğü değerler; kur ile birlikte bir kez yazılır.
  fxPolicy        String?   // BT_UNIT_SELL | BNR | BNR_PLUS_PERCENT
  fxCurrency      String?
  fxBaseRate      Decimal?  @db.Decimal(12, 6)
  fxMarkupPercent Decimal?  @db.Decimal(6, 3)
  fxSourceDate    DateTime? @db.Date
  fxResolvedAt    DateTime?
  fxManual        Boolean?
  paidAt     DateTime? // yönetici "Ödeme alındı" dediyse
  paidAmount Decimal?  @db.Decimal(14, 2) // RON, TVA dahil (avans faturasının tutarı)
  paidById   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// Yükleme (yükleme günü) başına nakliye maliyeti; yönetici elle girer. Bir güne birden çok kalem girilebilir.
model LoadingCost {
  id          String   @id @default(cuid())
  shipDay     DateTime @db.Date
  amount      Decimal  @db.Decimal(14, 2)
  currency    String
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([shipDay])
}

// ---------------------------------------------------------
// YÜKLEME ONAYI (karar 92) — camın FİİLEN yüklendiğinin kaydı. Planlanan yükleme günü kanıt değildir.
// Yükleme günü başına tek onay. Kayıtlar yalnızca eklenir: onaylanan yükleme değiştirilmez / silinmez
// (veritabanı tetikleyicisiyle de korunur). Düzeltme gerekirse ayrı, denetimli bir iş akışı olarak eklenecek.
// ---------------------------------------------------------
// Müşterinin kur politikası (karar 95)
enum FxPolicy {
  BT_UNIT_SELL     // Banca Transilvania → "În unitățile BT" → "Vânzare"
  BNR              // BNR resmî kuru
  BNR_PLUS_PERCENT // BNR + müşteriye özel yüzde
}

enum LoadedStatus {
  LOADED     // fiilen yüklendi
  NOT_LOADED // planlanmıştı ama yüklenmedi (neden: notLoadedReason); sonraki yüklemeye aktarılabilir
}

model LoadingConfirmation {
  id            String   @id @default(cuid())
  shipDay       DateTime @unique @db.Date // yükleme günü: aynı gün iki kez onaylanamaz
  confirmedById String
  confirmedBy   User     @relation("LoadingConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt   DateTime @default(now())
  note          String?
  createdAt     DateTime @default(now())
  items         LoadingConfirmationItem[]
  corrections   LoadingCorrection[] // düzeltmeler (yalnızca eklenir; onayın kendisi ve ilk kalemleri değişmez)
  billingBatches BillingBatch[] // bu onaydan kesilen müşteri faturası partileri (karar 101)
}

// Onaylı yüklemenin düzeltmesi (Aşama 7F-1, karar 104): onay ve kalemleri DEĞİŞMEZ; düzeltme yeni bir kayıttır ve
// düzeltilen kapsamların (sipariş + teklif satırı / aktarım) yüklenen / yüklenmeyen kalemleri YENİ satırlar olarak
// eklenir (LoadingConfirmationItem.revision = bu düzeltmenin sırası, correctionId). Bir kapsamın geçerli hâli en yüksek
// sıradaki kalemleridir (server/loading/confirmation.js → effectiveItems); eski satırlar tarihçe olarak durur.
// Yalnızca eklenir: veritabanı tetikleyicisi UPDATE / DELETE / TRUNCATE'i reddeder.
model LoadingCorrection {
  id             String   @id @default(cuid())
  confirmationId String
  confirmation   LoadingConfirmation @relation(fields: [confirmationId], references: [id], onDelete: Restrict)
  revision       Int      // 1 = ilk düzeltme, 2 = ikinci … (0 = onayın kendisi)
  reason         String   // zorunlu açıklama
  createdById    String
  createdBy      User     @relation("LoadingCorrectedBy", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  items          LoadingConfirmationItem[]
  closedReplans  LoadingReplan[] // bu düzeltmeyle kapanan (artık sığmayan) aktarımlar

  @@unique([confirmationId, revision])
}

// Onay anında müşteriye gönderilmiş teklifin bir satırının kopyası (cam, CNC, delik, sandık parası…), FİİLEN onaylanan
// miktarla. Sonradan fiyat tablosu, teklif, müşteri fiyatı ya da cam kataloğu değişse de bu kayıt değişmez.
// Aynı kopya üzerinde mevcut hesap kuralı (glassTotals) çalışır: kârlılık ve (Aşama 7D) fatura buradan türetilir.
model LoadingConfirmationItem {
  id             String   @id @default(cuid())
  confirmationId String
  confirmation   LoadingConfirmation @relation(fields: [confirmationId], references: [id])
  // Ticari sahip: camın GERÇEK müşterisi ve siparişi. Fiziksel sandık yerleşimi (bir müşterinin camı başka müşterinin
  // sandığında gidebilir) buna bağlı değildir; ileride ayrı bir ilişki olarak eklenir.
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id])
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  // Kaynak teklif satırı (müşteriye gönderilmiş sürüm). Onaylı yüklemeye girmiş satır silinemez (Restrict).
  offerLineId    String?
  offerLine      OfferLine? @relation(fields: [offerLineId], references: [id], onDelete: Restrict)
  sortOrder      Int      // teklif içindeki sıra (CNC / delik üstündeki cama aittir)
  // Satırın anlık kopyası
  kind           String   // CAM | CNC | DELIK
  unit           String   // m2 | adet
  description    String   // cam adı (TR)
  descriptionRo  String?  // cam adı (RO)
  glassProductId String?
  enMm           Int?
  boyMm          Int?
  weightKgM2     Decimal? @db.Decimal(6, 2)
  free           Boolean  @default(false) // müşteriye bedelsiz (maliyeti yine sayılır)
  // FİİLEN onaylanan miktar: kısmi yüklemede teklif satırının adedinden az olabilir (kalan kısım NOT_LOADED kaydıdır)
  quantity       Int
  pieceBase      Int      @default(0) // OfferLine.pieceBase kopyası (karar 114): ayrılmış camın kalemdeki sırası — m² aynı kuralla hesaplanır
  m2             Decimal  @db.Decimal(10, 2) // cam satırında onaylanan m²; diğer satırlarda 0
  currency       String
  unitCost       Decimal  @db.Decimal(12, 2) // fabrika maliyeti: OfferLine.unitPrice (satış fiyatı)
  unitSale       Decimal? @db.Decimal(12, 2) // müşteri fiyatı: OfferLine.offerPrice (yönetici)
  costAmount     Decimal  @db.Decimal(14, 4) // miktar × birim maliyet (yuvarlanmamış; toplamlar grup düzeyinde yuvarlanır)
  saleAmount     Decimal  @db.Decimal(14, 4) // miktar × müşteri fiyatı (bedelsiz satırda 0)
  status         LoadedStatus @default(LOADED)
  notLoadedReason String? // yalnızca NOT_LOADED: BROKEN | MISSING | NOT_READY | OTHER (server/loading/replan.js → NOT_LOADED_REASONS)
  notLoadedNote   String? // yalnızca NOT_LOADED: açıklama (OTHER için zorunlu)
  // Bu kalem, daha önceki bir onayda yüklenmeyen camın ileri bir güne aktarılmış kalanıdır (Aşama 7E): hangi aktarımdan
  // geldiği. Zincir: yüklenmeyen kalem → aktarım (LoadingReplan) → bu kalem (→ yine yüklenmediyse yeni aktarım …).
  replanId       String?
  replan         LoadingReplan? @relation("ReplanItems", fields: [replanId], references: [id], onDelete: Restrict)
  replans        LoadingReplan[] @relation("ReplanSource") // bu (yüklenmeyen) kalemin ileri güne aktarımları
  compensations  Compensation[]  // bu (yüklenmeyen) kalemin yerine açılan telafiler (Aşama 9)
  // Düzeltme (Aşama 7F-1): 0 = onay anındaki kalem; n = n. düzeltmeyle eklenen kalem (correctionId). Kapsamın geçerli
  // hâli en yüksek sıradaki kalemleridir; önceki satırlar değişmeden durur.
  revision       Int      @default(0)
  correctionId   String?
  correction     LoadingCorrection? @relation(fields: [correctionId], references: [id], onDelete: Restrict)
  // Kapsam anahtarı (itemKey): "l:<teklif satırı>" ya da "r:<aktarım>". Yalnızca bu sürümden sonra eklenen kalemlerde
  // doludur (eski satırlar değişmez); benzersizlik denetimi içindir — kapsam kodda hep itemKey ile hesaplanır. Yeni
  // satırlarda zorunludur ve kapsamla tutarlı olmalıdır (veritabanı denetimi, NOT VALID — elle yazılmış migration).
  scopeKey       String?
  createdAt      DateTime @default(now())

  // Bir onayda bir kapsam için sıra ve durum başına tek kayıt (yüklenen kısım + yüklenmeyen kısım)
  @@unique([confirmationId, scopeKey, status, revision], map: "LoadingConfirmationItem_scope_key")
  // Bir aktarım en çok bir kez onaylanır: sıra başına tek LOADED + tek NOT_LOADED kalem (aynı kalan iki kez yüklenemez)
  @@unique([replanId, status, revision], map: "LoadingConfirmationItem_replan_key")
  @@index([orderId])
  @@index([customerId])
}

enum ReplanStatus {
  ACTIVE    // ileri güne planlı; o gün onaylanınca kalemlere dönüşür
  CONFIRMED // planlandığı günün yükleme onayına girdi (yüklenen / yine yüklenmeyen kalemler replanId ile bağlı)
  CANCELLED // yönetici vazgeçti ya da başka güne aldı (yerine yeni kayıt açılır)
}

// Yüklenmeyen (kırık / eksik / hazır olmayan) camın ileri bir yükleme gününe aktarılması (Aşama 7E, karar 102).
// Yalnızca LOJİSTİK bir plandır: sipariş, müşteri, teklif satırı ve ticari değerler kaynağın (yüklenmeyen onay kaleminin)
// kopyasından gelir; yeni sipariş açılmaz, eski yükleme onayı değişmez. Aktarılan miktar kaynağın kalan miktarının
// tamamıdır. Kaynak başına tek etkin aktarım (activeKey benzersiz).
model LoadingReplan {
  id           String   @id @default(cuid())
  sourceItemId String
  sourceItem   LoadingConfirmationItem @relation("ReplanSource", fields: [sourceItemId], references: [id], onDelete: Restrict)
  // Ticari sahip (kaynağın kopyası): sipariş ve gerçek müşterisi
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quantity     Int      // aktarılan adet (> 0; kalanın tamamı ya da bir kısmı)
  m2           Decimal  @db.Decimal(10, 2)
  reason       String   // kaynağın nedeni (BROKEN | MISSING | NOT_READY | OTHER)
  fromDay      DateTime @db.Date // kaynağın yükleme günü (yüklenmediği onay)
  shipDay      DateTime @db.Date // yeni yükleme günü
  status       ReplanStatus @default(ACTIVE)
  // Vazgeçilmemişken "<onay>|<kapsam>|<hedef gün>" (eski kayıtlarda kaynak kalemin kimliği), vazgeçilince boş: aynı
  // kapsamdan aynı güne ikinci aktarım (çift tıklama) veritabanında da olamaz. Bir kapsamın birden çok güne aktarımı
  // olabilir (kısmi aktarım, Aşama 7F-1); toplamı kapsamın geçerli yüklenmeyen adedini aşamaz (kilit altında denetlenir).
  activeKey    String?  @unique
  createdById  String
  createdBy    User     @relation("ReplanCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  closedAt     DateTime? // onaylandığı ya da vazgeçildiği an
  // Vazgeçilmiş (CANCELLED) kaydın nedeni: ADMIN (yönetici vazgeçti) | MOVED (başka güne alındı) | CORRECTION (yükleme
  // düzeltmesiyle yüklenmeyen adet azaldı, aktarım sığmadı — correctionId)
  closedReason String?
  correctionId String?
  correction   LoadingCorrection? @relation(fields: [correctionId], references: [id], onDelete: Restrict)
  items        LoadingConfirmationItem[] @relation("ReplanItems")

  @@index([shipDay, status])
  @@index([orderId])
}

// Fabrikaya yapılan ödemeler: yüklemelere ve siparişlere BAĞLI DEĞİL (fabrika cari hesabı).
model FactoryPayment {
  id          String   @id @default(cuid())
  paidOn      DateTime @db.Date
  amount      Decimal  @db.Decimal(14, 2)
  currency    String
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([paidOn])
}

// ---------------------------------------------------------
// TEDARİKÇİLER VE SATIN ALMA (Paket 6, kararlar 179–184) — yalnızca yönetici (SUPPLIER_MANAGE)
// ---------------------------------------------------------
// Profil, conta, plastik ve aksesuar tedarikçileri. Cam fabrikasının hesabı (Muhasebe → Tedarikçi Hesap Durumu,
// FactoryPayment) ayrıdır ve değişmez. Tedarikçi fiziksel olarak silinmez (geçmişi korunur), yalnızca pasif yapılır.
model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  // Sipariş e-postasının TEK alıcısı; yalnızca Ayarlar → Tedarikçiler'de değişir. Boş / geçersizse gönderim engellenir.
  email       String?
  phone       String?
  address     String?
  currency    String   // EUR | RON | USD | TRY — siparişlerin ve borcun para birimi
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    ProfileProduct[]
  orders      SupplierOrder[]
  payments    SupplierPayment[]

  @@index([isActive, name])
}

// Tedarikçi siparişinin durumu (karar 181). "Gönderildi" yalnızca e-posta GERÇEKTEN gönderildiğinde yazılır.
enum SupplierOrderStatus {
  TASLAK            // hiç kesinleşmedi: e-posta yok, borç yok
  GONDERIM_BEKLIYOR // kesinleşti (borç kayıtta); e-posta kuyrukta / gönderiliyor
  GONDERILDI        // son kesin revizyonun e-postası gönderildi
  GONDERIM_HATASI   // son kesin revizyonun e-postası gönderilemedi ya da sonucu belirsiz (yönetici "Tekrar gönder")
  TESLIM_ALINDI     // yönetici malın geldiğini işaretledi: beklenen tedarikten düşer, STOK DEĞİŞMEZ
  IPTAL             // gerekçeli iptal: borçtan düşer; tedarikçiye e-posta gitmez
}

// Tedarikçi siparişi: başlık (numara, tedarikçi, durum, tahmini yükleme tarihi). İçerik revizyonlardadır (karar 181):
// taslak revizyon düzenlenir; "Siparişi onayla / gönder" onu KESİNLEŞTİRİR (veritabanı tetikleyicisi kesin revizyonu,
// satırlarını ve eklerini değiştirmeye / silmeye izin vermez). Değişiklik = yeni revizyon (açıkça onaylanıp yeniden gönderilir).
model SupplierOrder {
  id           String   @id @default(cuid())
  orderNo      String   @unique
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  currency     String   // tedarikçinin para birimi (sipariş açılırken kopyalanır)
  status       SupplierOrderStatus @default(TASLAK)
  // Tahmini yükleme tarihi (karar 183): yalnızca yönetici elle girer; cam siparişlerinin yükleme tarihiyle ilgisi yoktur
  etaDate      DateTime? @db.Date
  sentAt       DateTime?
  sendError    String?  // son gönderim hatasının sabit kodu
  receivedAt   DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  version      Int      @default(0)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  revisions    SupplierOrderRevision[]

  @@index([supplierId, status])
  @@index([status, etaDate])
}

model SupplierOrderRevision {
  id            String   @id @default(cuid())
  orderId       String
  order         SupplierOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  revision      Int
  orderDate     DateTime @db.Date
  note          String?
  // Kesinleşince yazılır: satır tutarlarının toplamı; missingPrice = fiyatı olmayan satır var (toplam yalnızca bilinenler)
  total         Decimal? @db.Decimal(14, 2)
  missingPrice  Boolean  @default(false)
  finalizedAt   DateTime?
  finalizedById String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lines         SupplierOrderLine[]
  files         SupplierOrderFile[]

  @@unique([orderId, revision])
}

model SupplierOrderLine {
  id          String   @id @default(cuid())
  revisionId  String
  revision    SupplierOrderRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  productId   String
  product     ProfileProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  code        String   // ürün kodu (kopya)
  description String   // açıklama (Türkçe adın kopyası; yönetici değiştirebilir)
  color       String?  // Renk / RAL (serbest metin)
  qty         Int
  unitCode    String   // sipariş birimi (kopya)
  unitPrice   Decimal? @db.Decimal(12, 4) // boş = alış fiyatı yok (uydurulmaz)
  priceSource String?  // CATALOG: ürünün alış fiyatı · MANUAL: yönetici girdi
  lineTotal   Decimal? @db.Decimal(14, 2)
  sortOrder   Int      @default(0)

  @@index([revisionId, sortOrder])
  @@index([productId])
}

// Teknik ekler: revizyona aittir (yeni revizyona kopyalanır; disk dosyası ortaktır, otomatik silinmez).
model SupplierOrderFile {
  id            String   @id @default(cuid())
  revisionId    String
  revision      SupplierOrderRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  name          String
  storageKey    String
  size          Int
  mime          String?
  checksum      String?
  scanStatus    FileScanStatus @default(PENDING)
  scanSignature String?
  scannedAt     DateTime?
  uploadedById  String?
  createdAt     DateTime @default(now())

  @@index([revisionId])
  @@index([scanStatus])
}

// Tedarikçiye yapılan ödemeler (karar 182): yönetici elle girer; siparişlere bağlı değildir. Silinmez — gerekçeyle
// iptal edilir (voidedAt). Aynı form iki kez gönderilse de ödeme bir kez yazılır (requestKey).
model SupplierPayment {
  id          String   @id @default(cuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  paidOn      DateTime @db.Date
  amount      Decimal  @db.Decimal(14, 2)
  currency    String
  note        String?
  requestKey  String   @unique
  voidedAt    DateTime?
  voidedById  String?
  voidReason  String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([supplierId, paidOn])
}

// ---------------------------------------------------------------------------------------------------------------------
// Yöneticinin elle kaydettiği müşteri ödemesi / avansı (Paket 10, kararlar 206–208). FGO'nun doğruladığı tahsilattan
// (FgoDocument.paid) AYRIDIR ve onun yerine geçmez. Kayıt tek başına belge kesmez; avans faturası yöneticinin ayrı ve açık
// isteğiyle, zincirin kuralıyla kesilir (server/finance/payments.js → advanceable: max(FGO tahsilatı, elle kayıtlar) −
// avansı kesilen — aynı ödeme iki kez faturalanmaz). Kayıt düzenlenmez ve silinmez: yalnızca gerekçeyle geçersiz kılınır
// (avans faturasına girmişse kılınamaz). Veritabanı tetikleyicisi para alanlarının değişmesini ve silmeyi reddeder.
//   Zincir: sipariş başına belge zinciri (batchId boş) ya da siparişin girdiği müşteri proforması (batchId = PROFORMA partisi)
//   ron / rate: zincirin kayıtlı kuruyla kayıt anında hesaplanan RON karşılığı (EUR ödeme); RON ödemede rate boş
// ---------------------------------------------------------------------------------------------------------------------
enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  OTHER
}

model ManualPayment {
  id             String        @id @default(cuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  batchId        String?
  batch          BillingBatch? @relation("ManualPaymentBatch", fields: [batchId], references: [id], onDelete: Restrict)
  proformaRef    String        // kayıt anındaki proforma (seri + numara) — izlenebilirlik
  paidOn         DateTime      @db.Date
  amount         Decimal       @db.Decimal(14, 2)
  currency       String        // EUR | RON
  method         PaymentMethod
  reference      String?
  note           String?
  ron            Decimal       @db.Decimal(14, 2)
  rate           Decimal?      @db.Decimal(10, 4)
  // Bu ödemeyi karşılayan avans faturası (sipariş zinciri) ya da avans partisi (müşteri zinciri); belge FGO'da silinirse boşalır
  advanceDocId   String?
  advanceDoc     FgoDocument?  @relation("ManualPaymentAdvanceDoc", fields: [advanceDocId], references: [id], onDelete: SetNull)
  advanceBatchId String?
  advanceBatch   BillingBatch? @relation("ManualPaymentAdvanceBatch", fields: [advanceBatchId], references: [id], onDelete: SetNull)
  requestKey     String        @unique // formun tek kullanımlık anahtarı (çift gönderim tek kayıt)
  createdById    String
  createdBy      User          @relation("ManualPaymentCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  voidedAt       DateTime?
  voidedById     String?
  voidedBy       User?         @relation("ManualPaymentVoidedBy", fields: [voidedById], references: [id])
  voidReason     String?

  @@index([orderId])
  @@index([customerId, paidOn])
  @@index([batchId])
}
