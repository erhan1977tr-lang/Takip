// =========================================================
// TAKİP - Sipariş ve Üretim Portalı — Veri Modeli (Prisma / PostgreSQL)
// =========================================================
// Akış özeti:
//  1) Müşteri sipariş gönderir -> Order.status = YENI
//  2) Satış dosyayı kontrol eder: çizim gerekiyorsa çizim ekibine yönlendirir (drawingTrack = GEREKLI),
//     gerekmiyorsa drawingTrack = YOK. Her iki durumda status = HAZIRLANIYOR ve teklif taslağı açılır.
//  3) İki hat bağımsız yürür:
//     - Çizim: çizimci üstlenir -> çizimi yükler -> müşteri onaylar ya da revizyon ister
//     - Teklif: satış yazar -> sistem yöneticisi fiyatı onaylar -> teklif müşteride görünür
//     Müşteri teklifi ONAYLAMAZ, yalnızca görür. Müşterinin tek onayı çizim onayıdır.
//  4) Çizim onaylı (ya da gereksiz) ve teklif müşterideyse satış siparişi üretime alır (URETIMDE)
//  5) Yükleme -> arşiv. Her olay OrderEvent'e, her değişiklik AuditLog'a yazılır.
// =========================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// KİMLİK / YETKİ
// ---------------------------------------------------------

enum UserType {
  INTERNAL // Sistem Yöneticisi, Satış, Çizim Ekibi
  CUSTOMER // Müşteri panelini kullanan kişiler
}

// Uygulamadaki panel/rol. Ayrıntılı yetkiler ileride Role/RolePermission ile genişletilir.
// Yetkiler rol adına değil server/auth/permissions.js matrisine göre verilir.
enum AppRole {
  ADMIN     // Sistem Yöneticisi
  SATIS
  CIZIM
  MUSTERI
  DENETIMCI // yalnızca görüntüler (karar 8)
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique // "Sistem Yöneticisi", "Satış", "Çizim Ekibi", "Organizatör"...
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime     @default(now())
}

// server/auth/permissions.js → PERMISSIONS ile aynı liste (seed bu tabloyu eşitler)
enum PermissionKey {
  ORDER_VIEW
  ORDER_CREATE
  ORDER_REVIEW
  ORDER_CANCEL
  DRAWING_WORK
  DRAWING_APPROVE
  OFFER_VIEW
  OFFER_DRAFT_VIEW
  OFFER_PREPARE
  OFFER_SEND
  PRICE_FINAL_VIEW
  SHIPMENT_VIEW
  FILE_UPLOAD
  FILE_INTERNAL_VIEW
  NOTE_ADD
  NOTE_INTERNAL_VIEW
  CUSTOMER_NAME_VIEW
  USER_MANAGE
  CUSTOMER_MANAGE
  CATALOG_MANAGE
  PRICE_TABLE_MANAGE
  ALERT_VIEW
  CRATE_EDIT
  OFFER_APPROVE
  STOCK_MANAGE
  SETTINGS_MANAGE
  AUDIT_VIEW
  ACCOUNTING_MANAGE
}

model RolePermission {
  id     String        @id @default(cuid())
  roleId String
  role   Role          @relation(fields: [roleId], references: [id])
  key    PermissionKey

  @@unique([roleId, key])
}

model User {
  id           String     @id @default(cuid())
  type         UserType
  name         String
  email        String     @unique
  // Yönetici hesabı yalnızca e-postayla açar; kullanıcı ilk girişte davet koduyla şifresini belirleyene kadar boştur.
  passwordHash String?
  phone        String?
  language     String     @default("tr")
  appRole      AppRole
  unit         String?    // birim etiketi: "fabrika satış", "fabrika çizim"...
  canApprove   Boolean    @default(false) // müşteri tarafında çizim onaylayabilir
  roleId       String?
  role         Role?      @relation(fields: [roleId], references: [id])
  teamTags     TeamTagOnUser[]

  // Bağlı olduğu firma: müşteri kullanıcıları için müşteri firması, iç ekip için fabrika
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id])

  // İlişkiler (bu kullanıcının oluşturduğu/atandığı kayıtlar)
  ordersCreated      Order[]        @relation("OrderCreatedBy")
  ordersAssignedDraw Order[]        @relation("OrderAssignedDrawer")
  offersCreated      Offer[]        @relation("OfferCreatedBy")
  pricesSet          Price[]        @relation("PriceSetBy")
  drawingsUploaded   Drawing[]      @relation("DrawingUploadedBy")
  drawingsSent       Drawing[]      @relation("DrawingSentBy")
  drawingsDecided    Drawing[]      @relation("DrawingDecidedBy")
  drawingFiles       DrawingFile[]  @relation("DrawingFileUploadedBy")
  notifications      Notification[]
  auditLogs          AuditLog[]
  settingsUpdated    IntegrationSetting[]
  // Satışçının fiyat tablosu (Aşama 3b): tek tablo; boşsa varsayılan tablo kullanılır
  priceTableId       String?
  priceTable         PriceTable?    @relation(fields: [priceTableId], references: [id], onDelete: SetNull)
  alertsCreated      AdminAlert[]   @relation("AlertCreatedBy")
  cratesUpdated      Crate[]        @relation("CrateUpdatedBy")
  alertsResolved     AdminAlert[]   @relation("AlertResolvedBy")
  invites            UserInvite[]
  sessions           Session[]
  orderNotes         OrderNote[]
  orderFiles         OrderFile[]
  orderEvents        OrderEvent[] @relation("OrderEventBy")
  orderDrafts        OrderDraft[]
  orderDraftFiles    OrderDraftFile[]

  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// Hatalı giriş / kod denemeleri: aynı e-posta + IP'den kısa sürede çok deneme olursa giriş geçici kilitlenir
// (server/auth/throttle.js). Başarılı girişte o e-posta + IP'nin kayıtları silinir; eski kayıtlar bir gün sonra temizlenir.
model AuthFailure {
  id        String   @id @default(cuid())
  kind      String   // LOGIN | CODE
  email     String
  ip        String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// İlk giriş / şifre sıfırlama için e-postayla gönderilen 6 haneli kod.
// Kodun kendisi saklanmaz; yalnızca HMAC özeti (server/auth/inviteCode.js).
// Yeni kod üretildiğinde kullanıcının açık davetleri usedAt ile kapatılır.
model UserInvite {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0) // MAX_ATTEMPTS'e ulaşınca kilitlenir
  usedAt    DateTime?
  sentAt    DateTime? // davet e-postası gönderildiyse; null ise "Davet edilmedi"
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

// Oturum: tarayıcıdaki çerezde rastgele bir belirteç durur, burada yalnızca özeti saklanır.
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?

  @@index([userId])
}

model TeamTag {
  id    String @id @default(cuid())
  name  String @unique // "Ekip etiketleri" menüsündeki gruplamalar
  users TeamTagOnUser[]
}

model TeamTagOnUser {
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  teamTagId String
  teamTag   TeamTag @relation(fields: [teamTagId], references: [id])

  @@id([userId, teamTagId])
}

// ---------------------------------------------------------
// MÜŞTERİ
// ---------------------------------------------------------

enum CustomerType {
  CUSTOMER // müşteri firması
  FACTORY  // fabrika (iç ekip bu firmaya bağlıdır)
}

// Firma: hem müşteri firmaları hem fabrika(lar) burada tutulur.
model Customer {
  id            String   @id @default(cuid())
  name          String   @unique // "Miru Glass", "FOL Expert", "Pelet Construct"...
  type          CustomerType @default(CUSTOMER)
  prefix        String?  @unique // firma kodu, tam 3 büyük harf (veritabanında CHECK): "MIR" → MIR5; müşteri firmalarında zorunlu, siparişi olan firmada değişmez
  groupName     String?
  camEtiket     String?  // varsayılan cam etiketi
  sandikEtiket  String?  // varsayılan sandık etiketi (fiziksel etiket ve nakliye listesi)
  contactPerson String?  // "Darius", "Mitariu", "Gabi panou dus" gibi
  email         String?
  phone         String?
  address       String?
  taxId         String?  // CUI (fatura: FGO Client[CodUnic])
  // Fatura bilgileri (Aşama 6b, FGO): Nr. Reg. Com., ülke (boşsa RO), județ, localitate
  regCom        String?
  country       String?
  county        String?
  city          String?
  users         User[]   // müşteri panelini kullanan kişiler
  orders        Order[]
  orderDrafts   OrderDraft[]
  crates        Crate[]
  // Müşteriye özel fiyat tablosu (yönetim kopyasında müşteri fiyatları buradan gelir)
  priceTableId  String?
  priceTable    PriceTable? @relation(fields: [priceTableId], references: [id], onDelete: SetNull)
  // Müşteriye özel profil fiyatları (Aşama 6): yoksa katalogdaki liste fiyatı
  profilePriceTableId String?
  profilePriceTable   ProfilePriceTable? @relation(fields: [profilePriceTableId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------
// SİPARİŞ
// ---------------------------------------------------------

// Sipariş tipleri (CLAUDE.md "Order types"). Yeni tip bir satır olarak eklenir; ekranlar ve numara biçimi buradan.
// İlk kayıtlar migration'da ve seed'de (prisma/seed/data/order-types.js).
model OrderType {
  code         String   @id // GLASS_ORDER, PROFILE_ORDER
  nameRo       String
  nameTr       String
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  numberFormat String   @default("{CODE}{SEQ}")
  usesSales    Boolean  @default(true) // false → satış kuyruklarına girmez
  usesDrawing  Boolean  @default(true) // false → çizim kuyruklarına girmez
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Siparişin genel aşaması. Çizim ve teklif, HAZIRLANIYOR aşamasında birbirinden bağımsız yürür.
enum OrderStatus {
  YENI         // müşteri gönderdi, satış inceliyor ("İnceleniyor")
  HAZIRLANIYOR // satış karar verdi; çizim (gerekiyorsa) ve teklif paralel hazırlanıyor
  URETIMDE     // satış üretime aldı (çizim onaylı ya da gereksiz + teklif müşteride)
  YUKLENDI
  ARSIVLENDI
  IPTAL
}

// Çizim hattı: müşteri yalnızca burada onay verir.
enum DrawingTrack {
  YOK              // çizim gerekmiyor
  GEREKLI          // satış çizim ekibine yönlendirdi, henüz üstlenilmedi
  YAPILIYOR        // çizimci üstlendi
  ONAY_BEKLIYOR    // çizim müşterinin onayında
  REVIZYON_ISTENDI // müşteri revizyon istedi
  ONAYLANDI        // müşteri onayladı
}

model Order {
  id                String      @id @default(cuid())
  orderNo           String      @unique // firma kodu + müşterinin sipariş numarası: "GLA68" (karar 5)
  customerId        String
  customer          Customer    @relation(fields: [customerId], references: [id])
  orderTypeCode     String      @default("GLASS_ORDER")
  orderType         OrderType   @relation(fields: [orderTypeCode], references: [code])
  // İyimser kilit: her iş akışı işleminde bir artar; aynı anda yapılan iki işlemden ikincisi reddedilir.
  version           Int         @default(0)

  customerOrderNo   Int         // müşterinin sipariş numarası: formda bir sonraki numarayla gelir, müşteri değiştirebilir
  title             String?     // "Gabi panou dus" gibi kısa açıklama
  status            OrderStatus @default(YENI)
  drawingTrack      DrawingTrack @default(YOK)
  drawingSince      DateTime?   // çizim hattının son değiştiği an (SLA için)
  onHold            Boolean     @default(false) // "Beklemeye al": listelerde ve yüklemede görünmez
  camEtiket         String?     // yönetici girer; boşsa firmanın varsayılanı
  sandikEtiket      String?

  createdById       String
  createdBy         User        @relation("OrderCreatedBy", fields: [createdById], references: [id])

  assignedDrawerId  String?
  assignedDrawer    User?       @relation("OrderAssignedDrawer", fields: [assignedDrawerId], references: [id])

  slaDeadline       DateTime?   // "15.0 sa kaldı" / "38.1 sa gecikme" hesaplanır
  estimatedShipDate DateTime?   // Tahmini Yükleme
  actualShipDate    DateTime?

  revisionCount     Int         @default(0)
  isEscalated       Boolean     @default(false)

  items             OrderItem[]
  offers            Offer[]
  price             Price?
  drawings          Drawing[]
  crates            Crate[]      // eski düzen (sipariş başına sandık); taşıma adımı yeni düzene çevirir
  crateLinks        CrateOrder[] // sipariş hangi sandıklarda (yükleme sekmesinde seçilir)
  shipmentId        String?
  shipment          Shipment?   @relation(fields: [shipmentId], references: [id])
  events            OrderEvent[]
  files             OrderFile[]
  alerts            AdminAlert[]
  notes             OrderNote[]
  outbox            NotificationOutbox[]
  fgoDocuments      FgoDocument[]
  glassBilling      GlassBilling?
  profile           ProfileOrder?        // yalnızca profil siparişinde
  profileItems      ProfileOrderItem[]
  stockMoves        StockMovement[]

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Numara firma ve sipariş tipi içinde tektir: GLA12 (cam) ile GLAP12 (profil) ayrı sıralardır
  @@unique([customerId, orderTypeCode, customerOrderNo])
  @@index([orderTypeCode])
  @@index([status])
  @@index([drawingTrack])
  @@index([customerId])
  @@index([estimatedShipDate])
}

// Taslak sipariş: müşteri formu yarım bırakıp sonra devam eder. Sipariş değildir — numarası, SLA'sı, geçmişi yoktur,
// satışın hiçbir listesine düşmez; yalnızca firmanın müşteri kullanıcıları görür. "Gönder"de sipariş olur ve silinir.
model OrderDraft {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  orderTypeCode   String   @default("GLASS_ORDER")
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  title           String?
  customerOrderNo Int?     // müşteri kendi numarasını yazdıysa; boşsa gönderirken bir sonraki numara önerilir
  note            String?  // "Ek bilgi": gönderilince müşterinin görebildiği not olur
  items           Json     @default("[]") // [{ glassProductId, qty }]
  files           OrderDraftFile[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId])
}

// Taslağa yüklenen dosya (içerik kontrolü ve antivirüsten geçmiş). Gönderilince siparişin dosyası olur.
model OrderDraftFile {
  id            String         @id @default(cuid())
  draftId       String
  draft         OrderDraft     @relation(fields: [draftId], references: [id], onDelete: Cascade)
  name          String
  storageKey    String         @unique
  size          Int
  mime          String?
  checksum      String?
  scanStatus    FileScanStatus @default(PENDING)
  scanSignature String?
  scannedAt     DateTime?
  uploadedById  String
  uploadedBy    User           @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime       @default(now())

  @@index([draftId])
}

// Sipariş olay geçmişi ("Hareketler"). event kodları server/orders/rules.js içindeki EVENTS ile tanımlıdır.
// Sipariş geçmişi: her iş akışı işlemi bir satır (durum değiştirdiyse önceki → sonraki durumla birlikte).
model OrderEvent {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event      String
  note       String?
  fromStatus OrderStatus?
  toStatus   OrderStatus?
  userId    String?
  user      User?    @relation("OrderEventBy", fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// Antivirüs taraması (ADR 0010). PENDING: taranmadı (tarayıcıya ulaşılamadı ya da eski dosya) → işçi sonra tarar.
// SKIPPED: antivirüs kapalıyken yüklendi. INFECTED: karantinada, indirilemez.
enum FileScanStatus {
  PENDING
  CLEAN
  INFECTED
  SKIPPED
}

enum OrderFileKind {
  CUSTOMER // müşterinin sipariş dosyası
  INTERNAL // iç ekibin eklediği dosya
}

// Yüklenen dosyalar diskte UPLOAD_DIR altında durur; burada yalnızca bilgisi tutulur.
model OrderFile {
  id           String        @id @default(cuid())
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind         OrderFileKind @default(CUSTOMER)
  name         String        // özgün dosya adı
  storageKey   String        @unique
  size         Int
  mime         String?       // içerikten belirlenir (uzantıya güvenilmez)
  checksum     String?       // SHA-256 (hex)
  scanStatus   FileScanStatus @default(PENDING)
  scanSignature String?      // virüs adı (INFECTED)
  scannedAt    DateTime?
  // Boş: sistemin ürettiği dosya (Comanda Depozit PDF'i) ya da depo bağlantısından yüklenen teslim belgesi
  uploadedById String?
  uploadedBy   User?         @relation(fields: [uploadedById], references: [id])
  source       String?       // null: kullanıcı · WAREHOUSE_FORM: depo formu (sistem) · DEPOT_LINK: depodan yüklenen teslim belgesi
  createdAt    DateTime      @default(now())

  @@index([orderId])
}

// Siparişteki notlar. internal=true ise müşteri görmez. Gönderilen not düzeltilemez.
model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  text      String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([orderId])
}

// Cam kataloğu: müşteri yeni siparişte buradan seçer (yönetici → Katalog; Excel ile de yüklenir).
// Aynı cam Türkçe ad + Türkçe renkten tanınır. Kullanıcı camı seçtiği dilde görür. Pasif cam hiçbir listede görünmez.
model GlassProduct {
  id         String   @id @default(cuid())
  nameTr     String
  colorTr    String   @default("")
  nameRo     String
  colorRo    String   @default("")
  nameEn     String?  // Excel'de durur; arayüzde İngilizce yok (karar 9)
  colorEn    String?
  weightKgM2 Decimal? @db.Decimal(6, 2) // kg/m² — yüklemelerde ağırlık hesabı; tekliflerde görünmez
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  orderItems OrderItem[]
  prices     PriceTableItem[]

  @@unique([nameTr, colorTr])
}

// Cam kalemleri: metraj, cam adedi, CNC, delik, ağırlık — Yüklemeler özetindeki sütunlarla birebir
model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id])
  // Müşterinin katalogdan seçtiği cam ve sipariş anındaki kopyası (katalog sonradan değişse de sipariş değişmez)
  glassProductId  String?
  glassProduct    GlassProduct? @relation(fields: [glassProductId], references: [id], onDelete: SetNull)
  glassName       String?  // Türkçe ad — renk
  glassNameRo     String?  // Romence ad — renk
  glassWeightKgM2 Decimal? @db.Decimal(6, 2)
  camAdedi    Int     @default(0)
  cnc         String? // CNC açıklaması, yoksa null ("–")
  delikSayisi Int?    // "DELİK" sütunu
  metraj      Decimal @default(0) @db.Decimal(10, 2) // m²
  netAgirlik  Decimal @default(0) @db.Decimal(10, 2) // kg — GERÇEK kayıt (satış girerse tahmini ezer)
  brutAgirlik Decimal? @db.Decimal(10, 2)
}

// ---------------------------------------------------------
// TEKLİF / FİYAT
// ---------------------------------------------------------

enum OfferStatus {
  HAZIRLANIYOR // satışta
  YONETIMDE    // sistem yöneticisinin onayında
  GONDERILDI   // müşteriye gitti
}

model Offer {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id])
  status      OfferStatus @default(HAZIRLANIYOR)
  statusSince DateTime    @default(now()) // SLA için
  sentAt      DateTime?   // müşteriye gönderildiği an
  currency    String      @default("EUR")
  amount      Decimal     @default(0) @db.Decimal(12, 2) // satış tutarı (satış fiyatlarıyla satırların toplamı)
  // Müşteri tutarı (yöneticinin müşteri fiyatlarıyla toplam, karar 4). Müşteri ve denetimci yalnızca bunu görür; satış hiç görmez.
  offerAmount Decimal?    @db.Decimal(12, 2)
  lines       OfferLine[]
  createdById String
  createdBy   User        @relation("OfferCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([orderId])
  // Satır fiyatlarının geldiği fiyat tablosu (teklif açılırken satışçının tablosu)
  priceTableId String?
  priceTable   PriceTable? @relation(fields: [priceTableId], references: [id], onDelete: SetNull)
  alerts       AdminAlert[]
}

// Teklif satırı. Metraj = en × boy × adet (m²); tutar = metraj × birim fiyat (birim m² ise) ya da adet × birim fiyat.
model OfferLine {
  id          String  @id @default(cuid())
  offerId     String
  offer       Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  sortOrder   Int     @default(0)
  description String
  poz         String?
  enMm        Int?
  boyMm       Int?
  adet        Int     @default(1)
  unit        String  @default("m2") // "m2" | "adet"
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  kind        String  @default("CAM") // CAM | CNC | DELIK — CNC ve delik satırları üstlerindeki cam satırına aittir
  free        Boolean @default(false) // bedelsiz: fiyat 0 kabul edilir
  // Katalogdaki cam (açıklama katalogla eşleştiyse) ve teklif anındaki kopyası
  glassProductId String?
  descriptionRo  String?  // camın Romence adı — Romence ekranda açıklama yerine gösterilir
  weightKgM2     Decimal? @db.Decimal(6, 2) // yüklemelerde ağırlık; teklifte görünmez
  // Fiyat tablosundaki liste fiyatı (satışçı bundan farklı fiyat girerse yöneticiye uyarı düşer)
  listPrice      Decimal? @db.Decimal(12, 2)
  // Müşteri fiyatı (yönetici girer; müşteri fiyat tablosundan gelebilir). unitPrice = satış fiyatı.
  offerPrice     Decimal? @db.Decimal(12, 2)
  // Profil teklifi satırı (kind = PROFIL): ürün ve birimi (CUTII, PUNGI, BARA, BUCATI); tutar = adet × fiyat
  profileProductId String?
  unitCode         String?
}

// Fiyat tabloları (Aşama 3b, karar 26): satışçıların teklife yazacağı liste fiyatları.
// Cam başına m² fiyatı; delik ve CNC için adet başına sabit fiyat.
enum PriceTableKind {
  SALES    // satışçıların liste fiyatları (satış fiyatı)
  CUSTOMER // müşteriye özel fiyatlar (yöneticinin müşteri fiyatı)
}

model PriceTable {
  id        String   @id @default(cuid())
  kind      PriceTableKind @default(SALES)
  name      String   @unique
  currency  String   @default("EUR")
  holePrice Decimal? @db.Decimal(12, 2) // delik başına
  cncPrice  Decimal? @db.Decimal(12, 2) // CNC işlemi başına
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false) // ataması olmayan satışçılar bunu kullanır (en fazla bir tablo)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  items     PriceTableItem[]
  users     User[]      // SALES: atanan satışçılar
  customers Customer[]  // CUSTOMER: bu fiyatları kullanan müşteri firmaları
  offers    Offer[]
}

model PriceTableItem {
  id             String       @id @default(cuid())
  tableId        String
  table          PriceTable   @relation(fields: [tableId], references: [id], onDelete: Cascade)
  glassProductId String
  glassProduct   GlassProduct @relation(fields: [glassProductId], references: [id], onDelete: Cascade)
  unitPrice      Decimal      @db.Decimal(12, 2) // m² fiyatı
  updatedAt      DateTime     @default(now()) @updatedAt

  @@unique([tableId, glassProductId])
}

// Yöneticinin "Önemli kararlar" listesi: bir insan kararı bekleyen durumlar
// (ör. satışçı liste fiyatını değiştirdi). Yönetici "Gördüm" deyince kapanır; silinmez.
model AdminAlert {
  id           String    @id @default(cuid())
  type         String    // PRICE_OVERRIDE
  orderId      String?
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  offerId      String?
  offer        Offer?    @relation(fields: [offerId], references: [id], onDelete: SetNull)
  details      Json
  createdById  String?
  createdBy    User?     @relation("AlertCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("AlertResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([resolvedAt, createdAt])
}

model Price {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  amount    Decimal  @db.Decimal(12, 2) // "Satış Tutarı" — sistem yöneticisi girer
  setById   String
  setBy     User     @relation("PriceSetBy", fields: [setById], references: [id])
  setAt     DateTime @default(now())
}

// ---------------------------------------------------------
// ÇİZİM
// ---------------------------------------------------------

enum DrawingSource {
  FABRIKA // "Çizim işleri — fabrika çizecek"
  MUSTERI_DXF_DWG // müşteri hazır çizim gönderdi
}

enum DrawingStatus {
  BEKLIYOR
  YAPILIYOR
  TASLAK           // çizimci dosyaları yükledi, henüz müşteriye göndermedi (müşteri görmez)
  ONAY_BEKLIYOR    // müşteriye gönderildi
  ONAYLANDI
  REVIZYON_ISTENDI
  GERI_CEKILDI     // çizimci, müşteri karar vermeden geri çekti (gerekçeyle)
}

// Çizim sürümü. Sürümler silinmez ve üzerine yazılmaz; müşteriye gönderilen sürümün dosyaları değişmez.
// Akış: TASLAK (dosyalar yüklenir) → "Müşteriye gönder" (tüm dosyalar virüs taramasından temiz geçmiş olmalı)
// → ONAY_BEKLIYOR → ONAYLANDI | REVIZYON_ISTENDI | GERI_CEKILDI.
model Drawing {
  id           String        @id @default(cuid())
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id])
  source       DrawingSource @default(FABRIKA)
  version      Int           @default(1)
  files        DrawingFile[]
  noteCustomer String?       // müşteriye görünen sürüm notu
  noteInternal String?       // yalnızca iç ekip
  sentAt       DateTime?
  sentById     String?
  sentBy       User?         @relation("DrawingSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?     // müşterinin onay / revizyon kararı
  decidedById  String?
  decidedBy    User?         @relation("DrawingDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  withdrawnAt  DateTime?
  withdrawReason String?
  // Eski düzen (sürüm başına tek dosya); prisma/seed/steps/drawing-files.mjs DrawingFile'a taşır
  fileUrl      String?
  fileName     String?
  fileSize     Int?
  mime         String?
  checksum     String?
  scanStatus   FileScanStatus @default(PENDING)
  scanSignature String?
  scannedAt    DateTime?
  status       DrawingStatus @default(BEKLIYOR)
  uploadedById String
  uploadedBy   User          @relation("DrawingUploadedBy", fields: [uploadedById], references: [id])
  revisions    DrawingRevision[]
  createdAt    DateTime      @default(now())

  @@unique([orderId, version])
}

// Çizim sürümünün dosyaları (PDF, DWG, DXF…). Her dosya yüklenirken virüs taramasından geçer.
model DrawingFile {
  id            String         @id @default(cuid())
  drawingId     String
  drawing       Drawing        @relation(fields: [drawingId], references: [id], onDelete: Restrict)
  name          String
  storageKey    String
  size          Int
  mime          String?
  checksum      String?
  scanStatus    FileScanStatus @default(PENDING)
  scanSignature String?
  scannedAt     DateTime?
  uploadedById  String
  uploadedBy    User           @relation("DrawingFileUploadedBy", fields: [uploadedById], references: [id])
  createdAt     DateTime       @default(now())

  @@index([drawingId])
  @@index([scanStatus])
}

model DrawingRevision {
  id            String   @id @default(cuid())
  drawingId     String
  drawing       Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  requestedById String
  comment       String
  createdAt     DateTime @default(now())
}

// ---------------------------------------------------------
// SANDIK (paketleme)
// ---------------------------------------------------------

// Sandık: yükleme sekmesinde, yükleme günü + müşteri için girilir (satış ya da yönetici).
// Sandık numarası o gün içinde tektir (müşteriler arasında da); hangi siparişlerin camlarını taşıdığı CrateOrder'da.
model Crate {
  id          String    @id @default(cuid())
  shipDay     DateTime? @db.Date // yükleme günü
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  orderId     String?   // eski düzen: sipariş başına sandık (prisma/seed/steps/crates.mjs yeni düzene taşır)
  order       Order?    @relation(fields: [orderId], references: [id])
  crateNo     Int
  lengthMm    Int?      // uzunluk
  widthMm     Int?      // genişlik
  heightMm    Int?      // yükseklik
  dimensions  String?   // eski düzende serbest metin ölçü
  netAgirlik  Decimal?  @db.Decimal(10, 2)
  brutAgirlik Decimal?  @db.Decimal(10, 2)
  daraKg      Decimal   @default(50) @db.Decimal(6, 2) // brüt girilmezse net + dara
  note        String?
  orders      CrateOrder[]
  updatedAt   DateTime  @default(now()) @updatedAt
  updatedById String?
  updatedBy   User?     @relation("CrateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([shipDay, customerId])
}

model CrateOrder {
  crateId String
  crate   Crate  @relation(fields: [crateId], references: [id], onDelete: Cascade)
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@id([crateId, orderId])
  @@index([orderId])
}

// ---------------------------------------------------------
// YÜKLEME / TAKVİM
// ---------------------------------------------------------

enum ShipmentStatus {
  PLANLANDI
  BEKLEMEDE // "Beklemeye alınanlar bu listede görünmez"
  YUKLENDI
  IPTAL
}

model Shipment {
  id        String         @id @default(cuid())
  date      DateTime       // Yükleme günü
  status    ShipmentStatus @default(PLANLANDI)
  orders    Order[]
  createdAt DateTime       @default(now())
}

// ---------------------------------------------------------
// SÜREÇ KURALLARI (Ayarlar / Onay politikaları / SLA)
// ---------------------------------------------------------

model SlaPolicy {
  id          String   @id @default(cuid())
  stageName   String   // "İnceleniyor", "Çizim Yapılıyor" vb.
  maxHours    Int
  escalateTo  String?  // eskalasyon rolü/kullanıcı id
  isActive    Boolean  @default(true)
}

model ApprovalPolicy {
  id           String  @id @default(cuid())
  name         String
  maxRevisions Int     @default(3)
  description  String?
  isActive     Boolean @default(true)
}

// ---------------------------------------------------------
// BİLDİRİM
// ---------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Bildirim kuyruğu (ADR 0006): iş akışı işlemi aynı veritabanı işleminde buraya yazar; gönderim ayrı çalışır (Aşama 8).
enum OutboxStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model NotificationOutbox {
  id          String       @id @default(cuid())
  type        String       // ORDER_SENT_TO_DRAWING, ORDER_OFFER_SENT, FILE_INFECTED...
  orderId     String?
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payload     Json?
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  availableAt DateTime     @default(now())
  sentAt      DateTime?
  createdAt   DateTime     @default(now())

  @@index([status, availableAt])
}

// Entegrasyon ayarları (yönetici → Entegrasyonlar). Sır içermez; sırlar yalnızca sunucudaki .env'de.
model IntegrationSetting {
  key         String   @id // "antivirus"
  value       Json
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------
// DENETİM KAYDI — sadece okunur, hiçbir kayıt silinemez
// ---------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  actorRole  String?  // işlemi yapanın o anki rolü
  ip         String?
  action     String   // "ORDER_TRANSITION", "PRICE_SET", "USER_LOGIN" vb.
  entityType String   // "Order", "Drawing", "Price"...
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ---------------------------------------------------------
// PROFİL SİPARİŞİ (Aşama 6)
// ---------------------------------------------------------
// Satış ve çizim hiç devreye girmez. Akış (ProfileOrder.stage):
//   FIYAT_BEKLIYOR → (yönetici fiyatlar, gönderir) TEKLIF_GONDERILDI → (müşteri onaylar: alış tarihi, telefon, plaka) ONAYLANDI
//   → PROFORMA → ("Ödeme alındı": hemen depoya gider; ya da ödemeden önce "Siparişi depoya gönder") DEPODA
//   → TESLIM_EDILDI → FATURALANDI. Ödeme ayrı bir bilgidir (paidAt): depoya elle gönderilmiş siparişte sonradan girilebilir.
// Order.status genel listeler içindir: YENI (fiyat bekliyor) · HAZIRLANIYOR (teklif…depo) · ARSIVLENDI (faturalandı) · IPTAL.

enum ProfileStage {
  FIYAT_BEKLIYOR
  TEKLIF_GONDERILDI
  ONAYLANDI
  PROFORMA
  DEPODA
  TESLIM_EDILDI
  FATURALANDI
}

// Katalog kategorisi (GARNITURI, PLASTICE, PROFILE ALUMINIU, ACCESORII…). Silinmez, pasif yapılır.
model ProfileCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  nameRo    String
  nameTr    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  products  ProfileProduct[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Profil ürünü. code kalıcıdır (değişmez). Liste fiyatı EUR, KDV (TVA) hariç. Pasif ürün müşteri formunda görünmez.
model ProfileProduct {
  id         String   @id @default(cuid())
  code       String   @unique
  categoryId String
  category   ProfileCategory @relation(fields: [categoryId], references: [id])
  nameRo     String
  nameTr     String
  unitCode   String   // CUTII | PUNGI | BARA | BUCATI (prisma/seed/data/units.js)
  imageId    String?  // güncel görsel (yalnızca giriş yapmış kullanıcıya verilir)
  image      ProfileImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  listPrice  Decimal? @db.Decimal(12, 2)
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  metadata   Json?    // ileride ek bilgiler için
  prices     ProfilePriceItem[]
  stockMoves StockMovement[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([categoryId, sortOrder])
}

// Ürün görseli: değişmez kayıt (yeni görsel yeni satırdır; eski siparişler eski görseli göstermeye devam eder).
// Küçük görseller (en fazla 2 MB, JPG/PNG) veritabanında durur: yedekle birlikte taşınır, PDF üretimi dosya sistemine bağlı değildir.
model ProfileImage {
  id        String   @id @default(cuid())
  data      Bytes
  mime      String   // image/jpeg | image/png
  size      Int
  checksum  String
  name      String?
  createdById String?
  createdAt DateTime @default(now())
  products  ProfileProduct[]
}

// Müşteriye özel profil fiyat tablosu: birden çok firma aynı tabloyu kullanabilir.
model ProfilePriceTable {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  items     ProfilePriceItem[]
  customers Customer[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ProfilePriceItem {
  id        String            @id @default(cuid())
  tableId   String
  table     ProfilePriceTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  productId String
  product   ProfileProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitPrice Decimal           @db.Decimal(12, 2)
  updatedAt DateTime          @default(now()) @updatedAt

  @@unique([tableId, productId])
}

// Profil siparişinin iş akışı ve teslim bilgileri (Order ile bire bir).
model ProfileOrder {
  id               String       @id @default(cuid())
  orderId          String       @unique
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage            ProfileStage @default(FIYAT_BEKLIYOR)
  stageSince       DateTime     @default(now())
  // Müşteri onayı (müşteriye gönderilmiş son teklif)
  approvedAt       DateTime?
  approvedById     String?
  approvedOfferId  String?
  // Teslim bilgileri: depo e-postası gidene kadar müşteri değiştirebilir
  pickupDate       DateTime?    @db.Date
  contactPhone     String?
  vehiclePlate     String?
  // Proforma / ödeme / depo / teslim / fatura
  proformaNo       String?
  proformaAt       DateTime?
  paidAt           DateTime?    @db.Date
  warehouseSentAt  DateTime?
  stockDeducted    Boolean      @default(false)
  // Depo bağlantısı (e-postadaki tek kullanımlık adres): yalnızca özeti saklanır
  depotTokenHash   String?      @unique
  depotTokenExpiresAt DateTime?
  deliveredAt      DateTime?
  deliveredVia     String?      // DEPOT_LINK | ADMIN
  invoiceNo        String?
  invoicedAt       DateTime?
  // FGO (Aşama 6b): RON belge kuru = proforma günündeki BT EUR satış kuru; fatura aynı kurla kesilir
  fxRate           Decimal?     @db.Decimal(10, 4)
  fxDate           DateTime?    @db.Date
  fxSource         String?      // BT adresi | MANUAL
  proformaLink     String?      // FGO'nun belge bağlantısı
  proformaAmount   Decimal?     @db.Decimal(12, 2) // RON, TVA hariç
  invoiceLink      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt

  @@index([stage])
}

// Müşterinin istediği ürünler: sipariş anındaki kopya (katalog sonradan değişse de sipariş değişmez).
model ProfileOrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  code         String
  nameRo       String
  nameTr       String
  unitCode     String
  categoryCode String
  imageId      String?  // sipariş anındaki görsel (görsel değiştirilse de eskisi silinmez)
  qty          Int
  sortOrder    Int             @default(0)

  @@index([orderId])
}

enum StockMoveKind {
  GIRIS    // mal girişi (+)
  CIKIS    // depoya giden sipariş (−)
  SAYIM    // sayım düzeltmesi (±)
  IADE     // iptal edilen siparişin geri alınan çıkışı (+)
}

// Stok hareketleri: yalnızca eklenir (silinmez, düzeltilmez). Ürünün stoğu = hareketlerin toplamı.
model StockMovement {
  id          String         @id @default(cuid())
  productId   String
  product     ProfileProduct @relation(fields: [productId], references: [id])
  qty         Int            // + giriş, − çıkış
  kind        StockMoveKind
  orderId     String?
  order       Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  note        String?
  createdById String?
  createdAt   DateTime       @default(now())

  @@index([productId])
  @@index([orderId])
}

// ---------------------------------------------------------
// MUHASEBE (yalnızca yönetici)
// ---------------------------------------------------------

// FGO'da kesilen belgeler (proforma / fatura) ve FGO'dan okunan ödeme durumu. Belge kesilince kaydedilir
// (server/profile/transitions.js → fgo_proforma / fgo_invoice); "FGO ile güncelle" getstatus ile tutarı ve ödeneni yeniler.
model FgoDocument {
  id         String    @id @default(cuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind       String    // PROFORMA | ADVANCE (avans faturası, cam) | INVOICE
  series     String
  number     String
  issuedAt   DateTime
  link       String?
  currency   String    @default("RON")
  total      Decimal?  @db.Decimal(14, 2) // FGO "Valoare" (TVA dahil); ilk kontrolden önce boş
  paid       Decimal?  @db.Decimal(14, 2) // FGO "ValoareAchitata"
  checkedAt  DateTime?
  checkError String?
  createdAt  DateTime  @default(now())

  @@unique([series, number])
  @@unique([orderId, kind]) // sipariş başına her türden tek belge (çift kesim veritabanında da engellenir)
  @@index([orderId])
}

// Cam siparişi FGO belgeleri (Aşama: cam FGO): kur ve elle girilen ödeme. Belgelerin kendisi FgoDocument'te
// (PROFORMA → ADVANCE (avans faturası) → INVOICE). Müşteri onayı yok; sipariş durumu değişmez.
model GlassBilling {
  id         String    @id @default(cuid())
  orderId    String    @unique
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fxRate     Decimal?  @db.Decimal(10, 4) // proforma kuru (avans ve kapanış faturası da bunu kullanır)
  fxDate     DateTime? @db.Date
  fxSource   String?
  paidAt     DateTime? // yönetici "Ödeme alındı" dediyse
  paidAmount Decimal?  @db.Decimal(14, 2) // RON, TVA dahil (avans faturasının tutarı)
  paidById   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// Yükleme (yükleme günü) başına nakliye maliyeti; yönetici elle girer. Bir güne birden çok kalem girilebilir.
model LoadingCost {
  id          String   @id @default(cuid())
  shipDay     DateTime @db.Date
  amount      Decimal  @db.Decimal(14, 2)
  currency    String
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([shipDay])
}

// Fabrikaya yapılan ödemeler: yüklemelere ve siparişlere BAĞLI DEĞİL (fabrika cari hesabı).
model FactoryPayment {
  id          String   @id @default(cuid())
  paidOn      DateTime @db.Date
  amount      Decimal  @db.Decimal(14, 2)
  currency    String
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([paidOn])
}
